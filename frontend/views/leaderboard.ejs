<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Mindful – Rangliste</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.svg" />
    <link rel="stylesheet" href="/css/design-system.css?v=<%= Date.now() %>" />
    <link rel="stylesheet" href="/css/components.css?v=<%= Date.now() %>" />
    <link rel="stylesheet" href="/css/layout-components.css?v=<%= Date.now() %>" />
    <link rel="stylesheet" href="/css/animations.css?v=<%= Date.now() %>" />
    <link rel="stylesheet" href="/css/polish.css?v=<%= Date.now() %>" />
    <link rel="stylesheet" href="/css/accessibility.css?v=<%= Date.now() %>" />
    <link rel="stylesheet" href="/css/style.css?v=<%= Date.now() %>" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"
    />
  </head>
  <body>
    <div class="app-layout">
      <%- include('partials/sidebar') %>

      <main class="leaderboard-page">
        <header class="lb-header">
          <div>
            <div class="eyebrow">Community</div>
            <h1>Rangliste</h1>
            <p class="lb-subtitle">Heute · <span id="totalUsers">0</span> Nutzer · <span id="totalTodos">0</span> Aufgaben</p>
          </div>
        </header>

        <div class="lb-tabs" id="lbTabs">
          <button class="lb-tab active" onclick="switchTab('todosDone')">
            <i class="fas fa-check-circle"></i> Aufgaben
          </button>
          <button class="lb-tab" onclick="switchTab('pomodoro')">
            <i class="fas fa-clock"></i> Pomodoro
          </button>
          <button class="lb-tab" onclick="switchTab('tracked')">
            <i class="fas fa-stopwatch"></i> Zeiterfassung
          </button>
        </div>

        <div class="lb-table-wrap">
          <table class="lb-table" id="lbTable">
            <thead>
              <tr>
                <th>#</th>
                <th>Name</th>
                <th class="lb-col-value">Wert</th>
              </tr>
            </thead>
            <tbody id="lbBody"></tbody>
          </table>
        </div>

        <div class="lb-empty" id="lbEmpty" style="display:none">
          <i class="fas fa-trophy"></i>
          <p>Heute noch keine Einträge in dieser Kategorie</p>
        </div>
      </main>
    </div>

    <script src="/js/app.js?v=<%= Date.now() %>"></script>
    <script src="/js/leaderboard.js?v=<%= Date.now() %>"></script>
  </body>
</html>
