<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Mindful – Passwort zurücksetzen</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.svg" />
    <link rel="stylesheet" href="/css/login.css?v=<%= Date.now() %>" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
  </head>
  <body>
    <main class="auth-shell">
      <section class="auth-showcase">
        <div class="showcase-inner">
          <div class="brand-mark">
            <span class="brand-dot"></span>
            <span class="brand-name">MINDFUL</span>
          </div>
          <div class="showcase-copy">
            <h1>Neues Passwort</h1>
            <p class="lead">Wähle ein neues Passwort für deinen Account.</p>
          </div>
        </div>
      </section>

      <section class="auth-panel-wrap">
        <div class="auth-panel">
          <div class="auth-panel-head">
            <h2>Passwort zurücksetzen</h2>
            <p>Gib dein neues Passwort ein (mind. 6 Zeichen).</p>
          </div>

          <form id="resetForm" class="auth-form active">
            <input type="hidden" id="resetToken" value="<%= token %>" />
            <div class="form-group">
              <label>Neues Passwort</label>
              <div class="input-shell">
                <i class="fa-solid fa-lock"></i>
                <input type="password" id="newPassword" placeholder="mind. 6 Zeichen" required minlength="6" />
              </div>
            </div>
            <div class="form-group">
              <label>Passwort bestätigen</label>
              <div class="input-shell">
                <i class="fa-solid fa-lock"></i>
                <input type="password" id="confirmPassword" placeholder="Wiederholen" required minlength="6" />
              </div>
            </div>
            <button type="submit" class="primary-btn">Passwort zurücksetzen</button>
            <div style="text-align:center;margin-top:16px">
              <a href="/login" class="forgot-link">Zurück zum Login</a>
            </div>
          </form>

          <div id="authMessage" class="auth-message"></div>
        </div>
      </section>
    </main>

    <script>
      if (localStorage.getItem("darkMode") === "1" ||
          (!localStorage.getItem("darkMode") && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
        document.body.classList.add("dark");
      }
    </script>
    <script>
      document.getElementById("resetForm").addEventListener("submit", async (e) => {
        const TOKEN = document.getElementById("resetToken").value;
        e.preventDefault();
        const password = document.getElementById("newPassword").value;
        const confirm = document.getElementById("confirmPassword").value;
        const msgEl = document.getElementById("authMessage");

        if (password !== confirm) {
          msgEl.textContent = "Passwörter stimmen nicht überein";
          msgEl.className = "auth-message error";
          return;
        }

        try {
          const res = await fetch("/api/auth/reset-password", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ token: TOKEN, password }),
          });
          const data = await res.json();
          msgEl.textContent = data.message || data.error;
          msgEl.className = "auth-message " + (res.ok ? "success" : "error");
          if (res.ok) {
            setTimeout(() => window.location.href = "/login", 2000);
          }
        } catch (err) {
          msgEl.textContent = "Fehler bei der Anfrage";
          msgEl.className = "auth-message error";
        }
      });
    </script>
  </body>
</html>
