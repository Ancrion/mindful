<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Mindful – Entwicklungsplan</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.svg" />
    <link rel="stylesheet" href="/css/design-system.css?v=<%= Date.now() %>" />
    <link rel="stylesheet" href="/css/components.css?v=<%= Date.now() %>" />
    <link rel="stylesheet" href="/css/layout-components.css?v=<%= Date.now() %>" />
    <link rel="stylesheet" href="/css/animations.css?v=<%= Date.now() %>" />
    <link rel="stylesheet" href="/css/polish.css?v=<%= Date.now() %>" />
    <link rel="stylesheet" href="/css/accessibility.css?v=<%= Date.now() %>" />
    <link rel="stylesheet" href="/css/style.css?v=<%= Date.now() %>" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.8.0/styles/atom-one-dark.min.css" />
    <style>
      .dev-plan-page {
        padding: 40px 48px;
        max-width: 1400px;
        margin: 0 auto;
      }

      .dev-plan-header {
        margin-bottom: 40px;
      }

      .dev-plan-header h1 {
        font-size: 1.75rem;
        font-weight: 700;
        margin: 0;
      }

      .dev-plan-subtitle {
        color: var(--text-secondary);
        font-size: 0.9rem;
        margin: 8px 0 0;
      }

      /* ─── CONTROLS & FILTERS ─── */
      .dev-plan-controls {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 12px;
        margin: 32px 0;
      }

      .control-group {
        display: flex;
        flex-direction: column;
      }

      .control-group label {
        font-size: 0.8rem;
        font-weight: 500;
        margin-bottom: 6px;
        color: var(--text-secondary);
        text-transform: uppercase;
        letter-spacing: 0.5px;
      }

      .control-group input,
      .control-group select {
        padding: 10px 12px;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: var(--surface);
        color: var(--text-primary);
        font-size: 0.9rem;
      }

      .control-group input::placeholder {
        color: var(--text-secondary);
      }

      /* ─── STATISTICS ─── */
      .dev-plan-stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
        gap: 12px;
        margin: 32px 0;
      }

      .stat-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 16px;
        text-align: center;
      }

      .stat-card strong {
        display: block;
        font-size: 1.6rem;
        color: var(--accent);
        margin-bottom: 4px;
      }

      .stat-card span {
        font-size: 0.8rem;
        color: var(--text-secondary);
      }

      /* ─── TASKS GROUPING ─── */
      .dev-plan-section {
        margin-bottom: 48px;
      }

      .dev-plan-section-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 20px;
        padding-bottom: 12px;
        border-bottom: 2px solid var(--accent);
      }

      .dev-plan-section-header h2 {
        font-size: 1.2rem;
        font-weight: 600;
        margin: 0;
        flex: 1;
      }

      .section-count {
        font-size: 0.8rem;
        color: var(--text-secondary);
        background: var(--surface-2);
        padding: 4px 12px;
        border-radius: 20px;
      }

      /* ─── TASK CARD ─── */
      .dev-task-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-left: 4px solid var(--accent);
        border-radius: 10px;
        padding: 16px;
        margin-bottom: 12px;
        transition: all 0.2s;
        cursor: pointer;
      }

      .dev-task-card:hover {
        border-color: var(--accent);
        transform: translateX(4px);
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
      }

      .dev-task-card.status-done {
        border-left-color: #10b981;
        opacity: 0.65;
      }

      .dev-task-card.status-in_progress {
        border-left-color: #f59e0b;
      }

      .dev-task-card-header {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 16px;
        margin-bottom: 12px;
        align-items: start;
      }

      .dev-task-title {
        font-weight: 600;
        color: var(--text-primary);
        font-size: 0.95rem;
      }

      .dev-task-meta {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-top: 8px;
        font-size: 0.8rem;
      }

      .meta-badge {
        background: var(--surface-2);
        color: var(--text-secondary);
        padding: 2px 8px;
        border-radius: 4px;
        border: 1px solid var(--border);
      }

      .meta-badge.assignee {
        background: var(--accent-dim);
        color: var(--accent);
        border-color: var(--accent);
      }

      .meta-badge.status {
        background: var(--surface-2);
        color: var(--text-secondary);
      }

      .meta-badge.priority-high {
        background: #fee2e2;
        color: #dc2626;
      }

      .meta-badge.priority-medium {
        background: #fef3c7;
        color: #b45309;
      }

      .meta-badge.priority-low {
        background: #dbeafe;
        color: #1e40af;
      }

      .dev-task-file {
        font-family: var(--font-mono, monospace);
        font-size: 0.75rem;
        color: var(--accent);
        margin-top: 8px;
      }

      .dev-task-description {
        color: var(--text-secondary);
        font-size: 0.85rem;
        line-height: 1.4;
        margin-top: 8px;
      }

      .dev-task-code {
        background: #1e1e2e;
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 12px;
        margin-top: 12px;
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.3s;
        font-size: 0.75rem;
      }

      .dev-task-card.expanded .dev-task-code {
        max-height: 400px;
        overflow-y: auto;
      }

      .dev-task-code pre {
        margin: 0;
        color: #cdd6f4;
        font-family: 'JetBrains Mono', 'Fira Code', 'Cascadia Code', monospace;
        line-height: 1.5;
      }

      .dev-task-actions {
        display: flex;
        gap: 8px;
        margin-top: 12px;
        padding-top: 12px;
        border-top: 1px solid var(--border);
      }

      .action-btn {
        padding: 6px 12px;
        border: none;
        border-radius: 6px;
        background: var(--surface-2);
        color: var(--text-primary);
        font-size: 0.8rem;
        cursor: pointer;
        transition: all 0.2s;
      }

      .action-btn:hover {
        background: var(--accent);
        color: #fff;
      }

      /* ─── CODE MODAL ─── */
      .code-modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.5);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 9999;
        padding: 20px;
      }

      .code-modal-overlay.active {
        display: flex;
      }

      .code-modal {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        width: 100%;
        max-width: 900px;
        max-height: 85vh;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        box-shadow: 0 20px 60px rgba(0,0,0,0.3);
      }

      .code-modal-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px 20px;
        border-bottom: 1px solid var(--border);
      }

      .code-modal-header h3 {
        margin: 0;
        font-size: 0.95rem;
        font-weight: 600;
      }

      .code-modal-close {
        background: none;
        border: none;
        color: var(--text-secondary);
        font-size: 1.2rem;
        cursor: pointer;
        padding: 4px 8px;
        flex-shrink: 0;
      }

      .code-modal-body {
        flex: 1;
        overflow-y: auto;
        padding: 16px 20px;
      }

      .code-modal-body pre {
        background: #1e1e2e;
        color: #cdd6f4;
        border-radius: 8px;
        padding: 16px;
        font-family: 'JetBrains Mono', 'Fira Code', 'Cascadia Code', monospace;
        font-size: 0.75rem;
        line-height: 1.5;
        overflow-x: auto;
        white-space: pre;
        margin: 0;
      }

      .code-modal-footer {
        display: flex;
        gap: 8px;
        padding: 12px 20px;
        border-top: 1px solid var(--border);
        justify-content: flex-end;
      }

      .copy-btn {
        padding: 6px 16px;
        border: none;
        border-radius: 6px;
        background: var(--accent);
        color: #fff;
        font-size: 0.8rem;
        cursor: pointer;
        transition: all 0.2s;
      }

      .copy-btn:hover {
        opacity: 0.9;
      }

      /* ─── NO TASKS ─── */
      .no-tasks {
        text-align: center;
        padding: 60px 20px;
        color: var(--text-secondary);
      }

      .no-tasks i {
        font-size: 3rem;
        margin-bottom: 16px;
        opacity: 0.5;
      }

      .loading {
        text-align: center;
        padding: 40px 20px;
        color: var(--text-secondary);
      }

      @media (max-width: 768px) {
        .dev-plan-page {
          padding: 20px 16px;
        }

        .dev-plan-controls {
          grid-template-columns: 1fr;
        }

        .dev-task-card-header {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body>
    <%- include('components/sidebar.ejs', { currentPage }) %>

    <main class="app-main">
      <%- include('components/navbar.ejs', { currentPage }) %>

      <div class="dev-plan-page">
        <div class="dev-plan-header">
          <h1>📋 Entwicklungsplan</h1>
          <p class="dev-plan-subtitle">
            Dynamisches System zur Verwaltung aller Entwicklungsaufgaben. Klick auf eine Aufgabe um Code anzusehen.
            <a href="/dev-tasks-admin" style="color: var(--accent); text-decoration: none; margin-left: 12px;">
              <i class="fas fa-cog"></i> Admin Panel
            </a>
          </p>
        </div>

        <!-- CONTROLS -->
        <div class="dev-plan-controls">
          <div class="control-group">
            <label for="search-input">Suche</label>
            <input type="text" id="search-input" placeholder="Nach Titel/Beschreibung suchen..." />
          </div>
          <div class="control-group">
            <label for="filter-assignee">Bearbeiter</label>
            <select id="filter-assignee">
              <option value="all">Alle</option>
              <option value="ilhan">ilhan</option>
              <option value="jaro">jaro</option>
              <option value="team">Team</option>
            </select>
          </div>
          <div class="control-group">
            <label for="filter-status">Status</label>
            <select id="filter-status">
              <option value="all">Alle</option>
              <option value="open">Offen</option>
              <option value="in_progress">In Arbeit</option>
              <option value="done">Erledigt</option>
            </select>
          </div>
          <div class="control-group">
            <label for="filter-phase">Phase</label>
            <select id="filter-phase">
              <option value="all">Alle</option>
              <option value="Phase 1">Phase 1</option>
              <option value="Phase 2">Phase 2</option>
              <option value="Phase 3">Phase 3</option>
              <option value="Phase 4">Phase 4</option>
              <option value="Phase 5">Phase 5</option>
            </select>
          </div>
        </div>

        <!-- STATISTICS -->
        <div id="stats-container" class="dev-plan-stats">
          <div class="loading">Statistiken werden geladen...</div>
        </div>

        <!-- TASKS -->
        <div id="tasks-container">
          <div class="loading"><i class="fas fa-spinner fa-spin"></i> Aufgaben werden geladen...</div>
        </div>
      </div>
    </main>

    <!-- ─── CODE MODAL ─── -->
    <div class="code-modal-overlay" id="code-modal-overlay">
      <div class="code-modal">
        <div class="code-modal-header">
          <h3 id="code-modal-title">Code Snippet</h3>
          <button class="code-modal-close" onclick="closeCodeModal()">
            <i class="fas fa-times"></i>
          </button>
        </div>
        <div class="code-modal-body">
          <pre id="code-modal-content"></pre>
        </div>
        <div class="code-modal-footer">
          <button class="copy-btn" onclick="copyCodeToClipboard()">
            <i class="fas fa-copy"></i> Kopieren
          </button>
        </div>
      </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.8.0/highlight.min.js"></script>
    <script>
      let allTasks = [];
      let currentCodeContent = '';

      // Initialize on page load
      document.addEventListener('DOMContentLoaded', async () => {
        await loadTasks();
        setupEventListeners();
      });

      // Setup event listeners for filters
      function setupEventListeners() {
        document.getElementById('search-input').addEventListener('input', filterAndRender);
        document.getElementById('filter-assignee').addEventListener('change', filterAndRender);
        document.getElementById('filter-status').addEventListener('change', filterAndRender);
        document.getElementById('filter-phase').addEventListener('change', filterAndRender);
      }

      // Load tasks from API
      async function loadTasks() {
        try {
          const response = await fetch('/api/development-tasks');
          allTasks = await response.json();
          
          // Load code snippets for each task
          for (const task of allTasks) {
            const taskDetail = await fetch(`/api/development-tasks/${task.id}`);
            const detail = await taskDetail.json();
            task.code_snippet = detail.code_snippet;
          }
          
          filterAndRender();
          loadStats();
        } catch (err) {
          console.error('Error loading tasks:', err);
          document.getElementById('tasks-container').innerHTML = 
            `<div class="no-tasks"><i class="fas fa-exclamation-triangle"></i><p>Fehler beim Laden der Aufgaben</p></div>`;
        }
      }

      // Filter and render tasks
      function filterAndRender() {
        const search = document.getElementById('search-input').value.toLowerCase();
        const assignee = document.getElementById('filter-assignee').value;
        const status = document.getElementById('filter-status').value;
        const phase = document.getElementById('filter-phase').value;

        let filtered = allTasks.filter(task => {
          const matchSearch = !search || 
            task.title.toLowerCase().includes(search) || 
            (task.description && task.description.toLowerCase().includes(search)) ||
            task.file_path.toLowerCase().includes(search);
          
          const matchAssignee = assignee === 'all' || task.assignee === assignee;
          const matchStatus = status === 'all' || task.status === status;
          const matchPhase = phase === 'all' || task.phase === phase;

          return matchSearch && matchAssignee && matchStatus && matchPhase;
        });

        if (!filtered.length) {
          document.getElementById('tasks-container').innerHTML = 
            `<div class="no-tasks"><i class="fas fa-inbox"></i><p>Keine Aufgaben gefunden</p></div>`;
          return;
        }

        // Group by phase
        const grouped = {};
        filtered.forEach(task => {
          if (!grouped[task.phase]) {
            grouped[task.phase] = [];
          }
          grouped[task.phase].push(task);
        });

        // Render sections
        let html = '';
        const phases = Object.keys(grouped).sort();
        
        for (const phase of phases) {
          const tasks = grouped[phase];
          html += `
            <div class="dev-plan-section">
              <div class="dev-plan-section-header">
                <h2>${escapeHtml(phase)}</h2>
                <span class="section-count">${tasks.length} ${tasks.length === 1 ? 'Aufgabe' : 'Aufgaben'}</span>
              </div>
              <div>
                ${tasks.map(task => renderTaskCard(task)).join('')}
              </div>
            </div>
          `;
        }

        document.getElementById('tasks-container').innerHTML = html;

        // Add event listeners to task cards
        document.querySelectorAll('.dev-task-card').forEach(card => {
          card.addEventListener('click', function() {
            this.classList.toggle('expanded');
          });
        });

        // Add event listeners to action buttons
        document.querySelectorAll('[data-view-code]').forEach(btn => {
          btn.addEventListener('click', (e) => {
            e.stopPropagation();
            const taskId = btn.dataset.taskId;
            const task = allTasks.find(t => t.id === parseInt(taskId));
            if (task) {
              showCodeModal(task);
            }
          });
        });

        document.querySelectorAll('[data-view-file]').forEach(btn => {
          btn.addEventListener('click', (e) => {
            e.stopPropagation();
            alert('Full file viewer kommt bald!');
          });
        });
      }

      // Render task card
      function renderTaskCard(task) {
        const statusIcon = {
          'open': '⭕',
          'in_progress': '🔄',
          'done': '✅'
        };

        const icon = statusIcon[task.status] || '◯';

        return `
          <div class="dev-task-card status-${task.status}">
            <div class="dev-task-card-header">
              <div>
                <div class="dev-task-title">${icon} ${escapeHtml(task.title)}</div>
                <div class="dev-task-meta">
                  ${task.assignee ? `<span class="meta-badge assignee"><i class="fas fa-user"></i> ${escapeHtml(task.assignee)}</span>` : ''}
                  <span class="meta-badge status">${escapeHtml(task.status)}</span>
                  <span class="meta-badge priority-${task.priority}"><i class="fas fa-flag"></i> ${escapeHtml(task.priority)}</span>
                </div>
              </div>
            </div>
            <div class="dev-task-file">
              <i class="fas fa-file"></i> ${escapeHtml(task.file_path)}
              ${task.line_start ? ` <span style="color: var(--text-secondary);">[${task.line_start}:${task.line_end}]</span>` : ''}
            </div>
            ${task.description ? `<div class="dev-task-description">${escapeHtml(task.description)}</div>` : ''}
            ${task.code_snippet ? `
              <div class="dev-task-code">
                <pre><code>${escapeHtml(task.code_snippet)}</code></pre>
              </div>
            ` : ''}
            <div class="dev-task-actions">
              <button class="action-btn" data-view-code data-task-id="${task.id}">
                <i class="fas fa-code"></i> Code anzeigen
              </button>
              <button class="action-btn" data-view-file>
                <i class="fas fa-folder"></i> Datei öffnen
              </button>
            </div>
          </div>
        `;
      }

      // Show code modal
      function showCodeModal(task) {
        const title = document.getElementById('code-modal-title');
        const content = document.getElementById('code-modal-content');
        const overlay = document.getElementById('code-modal-overlay');

        title.textContent = `${task.title} (${task.file_path})`;
        
        if (task.code_snippet) {
          content.textContent = task.code_snippet;
          currentCodeContent = task.code_snippet;
        } else {
          content.textContent = 'Kein Code-Snippet verfügbar';
          currentCodeContent = '';
        }

        overlay.classList.add('active');
      }

      // Close code modal
      function closeCodeModal() {
        document.getElementById('code-modal-overlay').classList.remove('active');
      }

      // Copy code to clipboard
      async function copyCodeToClipboard() {
        try {
          await navigator.clipboard.writeText(currentCodeContent);
          const btn = event.target.closest('.copy-btn');
          const originalText = btn.innerHTML;
          btn.innerHTML = '<i class="fas fa-check"></i> Kopiert!';
          setTimeout(() => {
            btn.innerHTML = originalText;
          }, 2000);
        } catch (err) {
          console.error('Error copying:', err);
        }
      }

      // Load statistics
      async function loadStats() {
        try {
          const response = await fetch('/api/development-tasks/stats/summary');
          const stats = await response.json();

          const html = `
            <div class="stat-card">
              <strong>${stats.total}</strong>
              <span>Gesamt</span>
            </div>
            <div class="stat-card">
              <strong>${stats.open}</strong>
              <span>Offen</span>
            </div>
            <div class="stat-card">
              <strong>${stats.in_progress}</strong>
              <span>In Arbeit</span>
            </div>
            <div class="stat-card">
              <strong>${stats.done}</strong>
              <span>Erledigt</span>
            </div>
          `;

          document.getElementById('stats-container').innerHTML = html;
        } catch (err) {
          console.error('Error loading stats:', err);
          document.getElementById('stats-container').innerHTML = 
            '<div style="grid-column: 1/-1; color: var(--text-secondary);">Fehler beim Laden der Statistiken</div>';
        }
      }

      // Escape HTML
      function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
      }

      // Close modal when clicking overlay
      document.getElementById('code-modal-overlay').addEventListener('click', (e) => {
        if (e.target === e.currentTarget) {
          closeCodeModal();
        }
      });
    </script>
  </body>
</html>
