      let currentState = {};
      const STORAGE_KEY = "entwicklungsplan_status";

      function loadState() {
        const stored = localStorage.getItem(STORAGE_KEY);
        if (stored) {
          try {
            currentState = JSON.parse(stored);
          } catch (e) {
            currentState = {};
          }
        }
      }

      function saveState() {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(currentState));
      }

      function toggleTask(taskIndex) {
        currentState[taskIndex] = !currentState[taskIndex];
        saveState();
        renderPlan();
      }

      function renderPlan() {
        const container = document.getElementById("planContainer");
        const sections = {};

        // Group by phase
        tasks.forEach((task, idx) => {
          if (!sections[task.phase]) {
            sections[task.phase] = [];
          }
          sections[task.phase].push({ ...task, index: idx });
        });

        // Separate open and done tasks
        Object.keys(sections).forEach((phase) => {
          const phaseTasks = sections[phase];
          const open = phaseTasks.filter((t) => !currentState[t.index]);
          const done = phaseTasks.filter((t) => currentState[t.index]);
          sections[phase] = [...open, ...done];
        });

        let html = "";
        Object.entries(sections).forEach(([phase, phaseTasks]) => {
          const firstTask = phaseTasks[0];
          html += `<div class="plan-section">
            <div class="plan-section-header">
              <div class="avatar" style="background: ${firstTask.phaseColor}">${phase.substring(0, 1)}</div>
              <h2>${phase}</h2>
              <div class="section-role">${firstTask.assignee}</div>
              <div class="section-count">${phaseTasks.length} Tasks</div>
            </div>
            <div class="plan-tasks">`;

          phaseTasks.forEach((task) => {
            const isDone = currentState[task.index];
            const statusClass = isDone ? "status-done" : "";
            html += `
              <div class="plan-task ${statusClass}" data-task-idx="${task.index}">
                <button class="cb-wrap" onclick="toggleTask(${task.index}); event.stopPropagation();">
                  <span class="cb-box">${isDone ? "✓" : ""}</span>
                </button>
                <div class="info" onclick="showCode(${task.index})">
                  <div class="file">${task.file}</div>
                  <div class="title">${task.title}</div>
                  <div class="desc">${task.description}</div>
                  <div class="tags">
                    ${task.tags.map((tag) => `<span class="tag">${tag}</span>`).join("")}
                  </div>
                </div>
              </div>`;
          });

          html += `</div></div>`;
        });

        container.innerHTML = html;
        updateStats();
      }

      function updateStats() {
        const total = tasks.length;
        const done = Object.values(currentState).filter((v) => v).length;
        const open = total - done;
        document.getElementById("statTotal").textContent = total;
        document.getElementById("statDone").textContent = done;
        document.getElementById("statOpen").textContent = open;
      }

      function showCode(taskIndex) {
        const task = tasks[taskIndex];
        if (!task.codeSnippet) {
          alert("Kein Code-Snippet für diese Task verfügbar.");
          return;
        }
        const codeEl = document.getElementById(task.codeSnippet);
        if (!codeEl) {
          alert("Code-Snippet nicht gefunden.");
          return;
        }
        // Dekodiere HTML-Entities (&#34; → ", etc.)
        const div = document.createElement('div');
        div.innerHTML = codeEl.textContent;
        const code = div.textContent || div.innerText;
        document.getElementById("codeModalTitle").textContent = `${task.title} — ${task.file}`;
        document.getElementById("codeModalPre").textContent = code;
        document.getElementById("codeOverlay").classList.add("open");
      }

      function closeCodeModal() {
        document.getElementById("codeOverlay").classList.remove("open");
      }

      function copyCode() {
        const code = document.getElementById("codeModalPre").textContent;
        navigator.clipboard.writeText(code).then(() => {
          const btn = event.target.closest(".copy-btn");
          const originalText = btn.innerHTML;
          btn.innerHTML = '<i class="fas fa-check"></i> Kopiert!';
          setTimeout(() => {
            btn.innerHTML = originalText;
          }, 2000);
        });
      }

      document.addEventListener("DOMContentLoaded", () => {
        loadState();
        renderPlan();
      });
    </script>
  </body>
