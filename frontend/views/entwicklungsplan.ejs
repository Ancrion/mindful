<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Mindful – Entwicklungsplan</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.svg" />
    <link rel="stylesheet" href="/css/style.css?v=<%= Date.now() %>" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"
    />
    <style>
      .plan-page { padding: 40px 48px; max-width: 1100px; }
      .plan-page h1 { font-size: 1.75rem; font-weight: 700; margin: 0; }
      .plan-subtitle { color: var(--text-secondary); font-size: 0.9rem; margin: 4px 0 32px; }

      .plan-summary {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
        gap: 12px;
        margin-bottom: 36px;
      }
      .plan-stat {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 16px 20px;
        text-align: center;
      }
      .plan-stat strong { display: block; font-size: 1.6rem; }
      .plan-stat span { font-size: 0.78rem; color: var(--text-secondary); }

      .plan-team {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
        gap: 12px;
        margin-bottom: 36px;
      }
      .plan-member {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 14px 16px;
        display: flex;
        align-items: center;
        gap: 12px;
      }
      .plan-member .avatar {
        width: 38px; height: 38px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-weight: 700; font-size: 0.85rem; color: #fff; flex-shrink: 0;
      }
      .plan-member .info strong { display: block; font-size: 0.85rem; }
      .plan-member .info small { font-size: 0.72rem; color: var(--text-secondary); }

      .plan-phase { margin-bottom: 28px; }
      .plan-phase h2 {
        font-size: 1.1rem; font-weight: 600; margin: 0 0 12px;
        display: flex; align-items: center; gap: 10px;
      }

      .plan-task {
        background: var(--surface);
        border: 1px solid var(--border);
        border-left: 4px solid var(--border);
        border-radius: 10px;
        padding: 14px 18px;
        margin-bottom: 8px;
        display: grid;
        grid-template-columns: 36px 100px 1fr 120px;
        gap: 12px;
        align-items: start;
        font-size: 0.85rem;
        transition: border-color 0.15s, opacity 0.15s;
        cursor: pointer;
      }
      .plan-task:hover { border-color: var(--accent); }
      .plan-task.status-done { border-left-color: #10b981; opacity: 0.7; }
      .plan-task.status-done:hover { opacity: 0.85; }
      .plan-task.status-wip { border-left-color: #f59e0b; }
      .plan-task.status-open { border-left-color: var(--border); }

      .plan-task .checkbox {
        width: 20px; height: 20px; border-radius: 6px;
        border: 2px solid var(--border);
        background: var(--surface);
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0; margin-top: 1px;
        transition: all 0.15s;
        color: transparent; font-size: 0.65rem;
      }
      .plan-task.status-done .checkbox {
        background: #10b981; border-color: #10b981; color: #fff;
      }
      .plan-task.status-wip .checkbox {
        border-color: #f59e0b; color: #f59e0b;
      }
      .plan-task.status-wip .checkbox::after { content: "\f04b"; font-family: "Font Awesome 6 Free"; font-weight: 900; font-size: 0.55rem; }

      .plan-task .person { font-weight: 600; white-space: nowrap; color: var(--text); }
      .plan-task .person small { display: block; font-weight: 400; font-size: 0.7rem; color: var(--text-secondary); }

      .plan-task .details .file { font-family: var(--font-mono, monospace); font-size: 0.78rem; color: var(--accent); margin-bottom: 4px; }
      .plan-task .details .desc { color: var(--text-secondary); line-height: 1.4; }
      .plan-task .details .commit-msg {
        margin-top: 6px;
        font-family: var(--font-mono, monospace);
        font-size: 0.72rem;
        background: var(--surface-2);
        display: inline-block;
        padding: 2px 8px;
        border-radius: 6px;
        color: var(--text-secondary);
      }

      .plan-task .status-select {
        text-align: right;
      }
      .plan-task .status-select select {
        font-size: 0.72rem;
        padding: 3px 8px;
        border-radius: 20px;
        border: 1px solid var(--border);
        background: var(--surface);
        color: var(--text);
        cursor: pointer;
        font-weight: 600;
        text-transform: uppercase;
        outline: none;
      }
      .plan-task .status-select select option { text-transform: uppercase; font-weight: 600; }

      .plan-footer {
        margin-top: 40px;
        padding: 20px 24px;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        font-size: 0.85rem;
        color: var(--text-secondary);
        line-height: 1.6;
      }
    </style>
  </head>
  <body>
    <div class="app-layout">
      <%- include('partials/sidebar') %>

      <main class="plan-page">
        <header style="margin-bottom:8px">
          <div class="eyebrow">Entwicklungsprozess</div>
          <h1>Projektplan</h1>
          <p class="plan-subtitle">
            Aufgaben abhaken sobald erledigt. Status und Fortschritt werden automatisch gespeichert.
          </p>
        </header>

        <!-- Statistics -->
        <div class="plan-summary" id="planSummary">
          <div class="plan-stat"><strong id="statTotal">0</strong><span>Tasks gesamt</span></div>
          <div class="plan-stat"><strong id="statDone">0</strong><span>erledigt</span></div>
          <div class="plan-stat"><strong id="statWip">0</strong><span>in Arbeit</span></div>
          <div class="plan-stat"><strong id="statOpen">0</strong><span>offen</span></div>
        </div>

        <!-- Team -->
        <div class="plan-team">
          <div class="plan-member">
            <div class="avatar" style="background:#4c91ff">SA</div>
            <div class="info"><strong>Sascha</strong><small>Backend · Daten</small></div>
          </div>
          <div class="plan-member">
            <div class="avatar" style="background:#10b981">JA</div>
            <div class="info"><strong>Jaro</strong><small>Backend</small></div>
          </div>
          <div class="plan-member">
            <div class="avatar" style="background:#f59e0b">OM</div>
            <div class="info"><strong>Omar</strong><small>Frontend</small></div>
          </div>
          <div class="plan-member">
            <div class="avatar" style="background:#cf79ff">AI</div>
            <div class="info"><strong>Aisha</strong><small>Frontend</small></div>
          </div>
          <div class="plan-member">
            <div class="avatar" style="background:#f97316">MO</div>
            <div class="info"><strong>Mo</strong><small>UI/UX</small></div>
          </div>
          <div class="plan-member">
            <div class="avatar" style="background:#8B5CF6">YA</div>
            <div class="info"><strong>Yaman</strong><small>UI/UX</small></div>
          </div>
          <div class="plan-member">
            <div class="avatar" style="background:#ef4444">IL</div>
            <div class="info"><strong>Ilhan</strong><small>Dateninfrastruktur</small></div>
          </div>
        </div>

        <!-- Phase 1: Dateninfrastruktur -->
        <div class="plan-phase">
          <h2>Phase 1 – Dateninfrastruktur</h2>

          <div class="plan-task status-open" data-id="t1-1">
            <div class="checkbox"></div>
            <div class="person">Ilhan, Sascha<small>Dateninfra / Backend</small></div>
            <div class="details">
              <div class="file">backend/database/db.js</div>
              <div class="desc"><code>messages</code>-Tabelle anlegen: <code>id</code>, <code>from_user_id</code>, <code>to_user_id</code>, <code>subject</code>, <code>body</code>, <code>read</code>, <code>created_at</code>. Migration am Ende der Datei einfügen.</div>
              <div class="commit-msg">git commit -m "add messages table schema with read flag and timestamps"</div>
            </div>
            <div class="status-select">
              <select onchange="setStatus('t1-1', this.value)">
                <option value="open" selected>offen</option>
                <option value="wip">in Arbeit</option>
                <option value="done">erledigt</option>
              </select>
            </div>
          </div>

          <div class="plan-task status-open" data-id="t1-2">
            <div class="checkbox"></div>
            <div class="person">Ilhan, Sascha<small>Dateninfra / Backend</small></div>
            <div class="details">
              <div class="file">backend/database/db.js</div>
              <div class="desc">Auto-Create für alle Tabellen: <code>notes</code>, <code>todos</code>, <code>pomodoro_sessions</code>, <code>tracked_time</code>, <code>messages</code> – prüfen ob vorhanden, ggf. erstellen.</div>
              <div class="commit-msg">git commit -m "ensure all tables auto-create on startup"</div>
            </div>
            <div class="status-select">
              <select onchange="setStatus('t1-2', this.value)">
                <option value="open" selected>offen</option>
                <option value="wip">in Arbeit</option>
                <option value="done">erledigt</option>
              </select>
            </div>
          </div>
        </div>

        <!-- Phase 2: Backend API – Community -->
        <div class="plan-phase">
          <h2>Phase 2 – Backend API: Community</h2>

          <div class="plan-task status-open" data-id="t2-1">
            <div class="checkbox"></div>
            <div class="person">Jaro, Sascha<small>Backend</small></div>
            <div class="details">
              <div class="file">backend/routes/leaderboard.js</div>
              <div class="desc">Neue Datei: <code>GET /api/leaderboard</code>. Zählt pro Benutzer: erledigte Todos (heute), Pomodoro-Sitzungen (heute), getrackte Zeit (heute). Gibt sortiertes Array zurück mit <code>user_id</code>, <code>name</code>, <code>initial</code>, <code>value</code>.</div>
              <div class="commit-msg">git commit -m "add leaderboard api returning all users per category"</div>
            </div>
            <div class="status-select">
              <select onchange="setStatus('t2-1', this.value)">
                <option value="open" selected>offen</option>
                <option value="wip">in Arbeit</option>
                <option value="done">erledigt</option>
              </select>
            </div>
          </div>

          <div class="plan-task status-open" data-id="t2-2">
            <div class="checkbox"></div>
            <div class="person">Jaro, Sascha<small>Backend</small></div>
            <div class="details">
              <div class="file">backend/routes/users.js</div>
              <div class="desc">Neue Datei: <code>GET /api/users</code> (alle Nutzer) und <code>GET /api/users/:id</code> (Profil + Stats: Todos erledigt, Pomodoro-Sessions, getrackte Zeit).</div>
              <div class="commit-msg">git commit -m "add user list and profile api for community features"</div>
            </div>
            <div class="status-select">
              <select onchange="setStatus('t2-2', this.value)">
                <option value="open" selected>offen</option>
                <option value="wip">in Arbeit</option>
                <option value="done">erledigt</option>
              </select>
            </div>
          </div>

          <div class="plan-task status-open" data-id="t2-3">
            <div class="checkbox"></div>
            <div class="person">Jaro, Sascha<small>Backend</small></div>
            <div class="details">
              <div class="file">backend/routes/messages.js</div>
              <div class="desc">Neue Datei: <code>POST /api/messages/send</code>, <code>GET /api/messages/inbox</code>, <code>GET /api/messages/sent</code>, <code>PUT /api/messages/:id/read</code>, <code>GET /api/messages/unread-count</code>.</div>
              <div class="commit-msg">git commit -m "add messaging api with send inbox sent read endpoints"</div>
            </div>
            <div class="status-select">
              <select onchange="setStatus('t2-3', this.value)">
                <option value="open" selected>offen</option>
                <option value="wip">in Arbeit</option>
                <option value="done">erledigt</option>
              </select>
            </div>
          </div>

          <div class="plan-task status-open" data-id="t2-4">
            <div class="checkbox"></div>
            <div class="person">Jaro, Sascha<small>Backend</small></div>
            <div class="details">
              <div class="file">backend/routes/index.js</div>
              <div class="desc">View-Routen hinzufügen: <code>/leaderboard</code>, <code>/rangliste</code>, <code>/user/:id</code>, <code>/messages</code>, <code>/nachrichten</code>, <code>/profile</code>, <code>/profil</code>, <code>/entwicklungsplan</code>. Alle mit <code>auth</code>-Middleware.</div>
              <div class="commit-msg">git commit -m "add view routes for leaderboard user messages profile and plan pages"</div>
            </div>
            <div class="status-select">
              <select onchange="setStatus('t2-4', this.value)">
                <option value="open" selected>offen</option>
                <option value="wip">in Arbeit</option>
                <option value="done">erledigt</option>
              </select>
            </div>
          </div>

          <div class="plan-task status-open" data-id="t2-5">
            <div class="checkbox"></div>
            <div class="person">Jaro, Sascha<small>Backend</small></div>
            <div class="details">
              <div class="file">backend/app.js</div>
              <div class="desc">Neue Router (<code>leaderboard.js</code>, <code>users.js</code>, <code>messages.js</code>) per <code>app.use('/api', ...)</code> einbinden.</div>
              <div class="commit-msg">git commit -m "wire up leaderboard users and messages api routers"</div>
            </div>
            <div class="status-select">
              <select onchange="setStatus('t2-5', this.value)">
                <option value="open" selected>offen</option>
                <option value="wip">in Arbeit</option>
                <option value="done">erledigt</option>
              </select>
            </div>
          </div>
        </div>

        <!-- Phase 3: Backend Bugfixes & Optimierungen -->
        <div class="plan-phase">
          <h2>Phase 3 – Backend Bugfixes & Optimierungen</h2>

          <div class="plan-task status-open" data-id="t3-1">
            <div class="checkbox"></div>
            <div class="person">Jaro, Sascha<small>Backend</small></div>
            <div class="details">
              <div class="file">backend/routes/kalender.js</div>
              <div class="desc">Fix: Dynamischer SET-Build bei PUT, sodass nur übergebene Felder aktualisiert werden. Ersetzt hartcodierte Spaltenliste.</div>
              <div class="commit-msg">git commit -m "fix calendar put to dynamically build SET clause for partial updates"</div>
            </div>
            <div class="status-select">
              <select onchange="setStatus('t3-1', this.value)">
                <option value="open" selected>offen</option>
                <option value="wip">in Arbeit</option>
                <option value="done">erledigt</option>
              </select>
            </div>
          </div>

          <div class="plan-task status-open" data-id="t3-2">
            <div class="checkbox"></div>
            <div class="person">Jaro, Sascha<small>Backend</small></div>
            <div class="details">
              <div class="file">backend/routes/todos.js</div>
              <div class="desc">Fix: <code>workspace_id</code> leeren String auf <code>null</code> setzen. <code>faellig</code>-Feld zurücksetzen wenn Datum gelöscht wird. <code>erledigt</code> automatisch Unix-Timestamp bei Status "erledigt". Quote-Escaping in SQL-Strings.</div>
              <div class="commit-msg">git commit -m "fix todos: workspace null, faellig clear, erledigt auto-timestamp, quote escaping"</div>
            </div>
            <div class="status-select">
              <select onchange="setStatus('t3-2', this.value)">
                <option value="open" selected>offen</option>
                <option value="wip">in Arbeit</option>
                <option value="done">erledigt</option>
              </select>
            </div>
          </div>

          <div class="plan-task status-open" data-id="t3-3">
            <div class="checkbox"></div>
            <div class="person">Jaro, Sascha<small>Backend</small></div>
            <div class="details">
              <div class="file">backend/routes/notizen.js</div>
              <div class="desc">Fix: Bei POST/PUT die Note mit <code>LEFT JOIN workspace</code> zurückgeben, damit Frontend workspace-Id und -Farbe sofort hat.</div>
              <div class="commit-msg">git commit -m "fix notes post/put to return workspace join data"</div>
            </div>
            <div class="status-select">
              <select onchange="setStatus('t3-3', this.value)">
                <option value="open" selected>offen</option>
                <option value="wip">in Arbeit</option>
                <option value="done">erledigt</option>
              </select>
            </div>
          </div>

          <div class="plan-task status-open" data-id="t3-4">
            <div class="checkbox"></div>
            <div class="person">Jaro, Sascha<small>Backend</small></div>
            <div class="details">
              <div class="file">backend/routes/search.js</div>
              <div class="desc">Fix: Such-Query verwendet <code>erstellt</code>-Spalte statt fehlendem <code>aktualisiert</code>. 8 Recent-Results. AbortController für Request-Abbruch. Spotlight-Design im Frontend.</div>
              <div class="commit-msg">git commit -m "fix search: correct column, 8 recents, abort controller, spotlight design"</div>
            </div>
            <div class="status-select">
              <select onchange="setStatus('t3-4', this.value)">
                <option value="open" selected>offen</option>
                <option value="wip">in Arbeit</option>
                <option value="done">erledigt</option>
              </select>
            </div>
          </div>

          <div class="plan-task status-open" data-id="t3-5">
            <div class="checkbox"></div>
            <div class="person">Jaro, Sascha<small>Backend</small></div>
            <div class="details">
              <div class="file">frontend/public/js/app.js (search)</div>
              <div class="desc">Search-UI: Keyboard-Navigation (Pfeiltasten, Enter, Escape), Spotlight-Modal-Overlay, Dokumente + Snippets in den Ergebnissen, Strg+K-Shortcut.</div>
              <div class="commit-msg">git commit -m "add keyboard nav, document results, and spotlight modal to search"</div>
            </div>
            <div class="status-select">
              <select onchange="setStatus('t3-5', this.value)">
                <option value="open" selected>offen</option>
                <option value="wip">in Arbeit</option>
                <option value="done">erledigt</option>
              </select>
            </div>
          </div>

          <div class="plan-task status-open" data-id="t3-6">
            <div class="checkbox"></div>
            <div class="person">Jaro, Sascha<small>Backend</small></div>
            <div class="details">
              <div class="file">frontend/public/js/notes.js</div>
              <div class="desc">Fix: Error-Toast in saveNote()-else-Zweig hinzugefügt. <code>showEditor()</code>-Toggle. Live-Preview-Toggle (Preview-Button). Toolbar deaktivieren wenn keine Notiz offen (<code>.editor-disabled</code>).</div>
              <div class="commit-msg">git commit -m "add error toast, showEditor toggle, live preview, disabled toolbar to notes"</div>
            </div>
            <div class="status-select">
              <select onchange="setStatus('t3-6', this.value)">
                <option value="open" selected>offen</option>
                <option value="wip">in Arbeit</option>
                <option value="done">erledigt</option>
              </select>
            </div>
          </div>
        </div>

        <!-- Phase 4: Frontend – Notizen -->
        <div class="plan-phase">
          <h2>Phase 4 – Frontend: Notizen-Seite</h2>

          <div class="plan-task status-open" data-id="t4-1">
            <div class="checkbox"></div>
            <div class="person">Omar, Aisha<small>Frontend</small></div>
            <div class="details">
              <div class="file">frontend/views/notes.ejs</div>
              <div class="desc">"Neue Notiz"-Button im Editor-Header hinzugefügt. Leeren-Zustand (Empty State) eingebaut. Live-Preview-Toggle-Button (Augen-Symbol). Toolbar ausgegraut wenn keine Notiz offen.</div>
              <div class="commit-msg">git commit -m "add new note button, empty state, live preview to notes page"</div>
            </div>
            <div class="status-select">
              <select onchange="setStatus('t4-1', this.value)">
                <option value="open" selected>offen</option>
                <option value="wip">in Arbeit</option>
                <option value="done">erledigt</option>
              </select>
            </div>
          </div>

          <div class="plan-task status-open" data-id="t4-2">
            <div class="checkbox"></div>
            <div class="person">Mo, Yaman<small>UI/UX</small></div>
            <div class="details">
              <div class="file">frontend/public/css/notes.css</div>
              <div class="desc">CSS für leeren Zustand (Empty State), deaktivierte Toolbar (<code>.editor-disabled</code>), Live-Preview-Styling.</div>
              <div class="commit-msg">git commit -m "add notes css for empty state, disabled toolbar, and live preview"</div>
            </div>
            <div class="status-select">
              <select onchange="setStatus('t4-2', this.value)">
                <option value="open" selected>offen</option>
                <option value="wip">in Arbeit</option>
                <option value="done">erledigt</option>
              </select>
            </div>
          </div>

          <div class="plan-task status-open" data-id="t4-3">
            <div class="checkbox"></div>
            <div class="person">Mo, Yaman<small>UI/UX</small></div>
            <div class="details">
              <div class="file">frontend/public/css/style.css</div>
              <div class="desc">Primäre/Sekundäre Button-Styles für Notes-Toolbar. Konsistente Akzentfarben.</div>
              <div class="commit-msg">git commit -m "add primary and secondary button styles for notes toolbar"</div>
            </div>
            <div class="status-select">
              <select onchange="setStatus('t4-3', this.value)">
                <option value="open" selected>offen</option>
                <option value="wip">in Arbeit</option>
                <option value="done">erledigt</option>
              </select>
            </div>
          </div>
        </div>

        <!-- Phase 5: Frontend – Community -->
        <div class="plan-phase">
          <h2>Phase 5 – Frontend: Community-Seiten</h2>

          <div class="plan-task status-open" data-id="t5-1">
            <div class="checkbox"></div>
            <div class="person">Omar, Aisha<small>Frontend</small></div>
            <div class="details">
              <div class="file">frontend/views/leaderboard.ejs</div>
              <div class="desc">Neue Seite: Rangliste mit Tab-Navigation (Aufgaben / Pomodoro / Zeiterfassung), Tabelle mit Platz #, Name, Wert. Gold/Silber/Bronze für Platz 1–3. Leerer Zustand.</div>
              <div class="commit-msg">git commit -m "create leaderboard page with category tabs and ranking table"</div>
            </div>
            <div class="status-select">
              <select onchange="setStatus('t5-1', this.value)">
                <option value="open" selected>offen</option>
                <option value="wip">in Arbeit</option>
                <option value="done">erledigt</option>
              </select>
            </div>
          </div>

          <div class="plan-task status-open" data-id="t5-2">
            <div class="checkbox"></div>
            <div class="person">Omar, Aisha<small>Frontend</small></div>
            <div class="details">
              <div class="file">frontend/public/js/leaderboard.js</div>
              <div class="desc">Lädt von <code>/api/leaderboard?type=…</code>. Tabs rendern. Gold/Silber/Bronze-Medaille. Leeren Zustand bei fehlenden Daten.</div>
              <div class="commit-msg">git commit -m "add leaderboard frontend with tab switching and medal styling"</div>
            </div>
            <div class="status-select">
