<script type="text/plain" id="mo-2">/* Empty State */
.editor-empty {
  flex: 1; display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  gap: 12px; padding: 40px; text-align: center;
  color: var(--text-secondary);
}
.editor-empty-icon { font-size: 48px; color: var(--border); margin-bottom: 4px; }
.editor-empty h3 { font-size: 18px; font-weight: 600; color: var(--text); margin: 0; }
.editor-empty p {
  font-size: 14px; color: var(--text-secondary);
  margin: 0 0 8px; max-width: 320px; line-height: 1.5;
}

/* Disabled Toolbar */
.editor-disabled .toolbar-format button,
.editor-disabled .toolbar-actions button {
  opacity: 0.35; pointer-events: none;
}

/* Live Preview */
.note-preview {
  flex: 1; padding: 28px 32px; overflow-y: auto;
  line-height: 1.8; font-size: 16px; color: var(--text);
}
.note-preview h1 { font-size: 26px; font-weight: 700; margin: 20px 0 10px; }
.note-preview h2 { font-size: 22px; font-weight: 600; margin: 18px 0 8px; }
.note-preview h3 { font-size: 18px; font-weight: 600; margin: 16px 0 6px; }
.note-preview p { margin: 0 0 12px; }
.note-preview ul, .note-preview ol { padding-left: 24px; margin: 8px 0; }
.note-preview blockquote {
  border-left: 3px solid var(--accent); margin: 12px 0;
  padding: 8px 16px; background: var(--surface-2);
  border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  color: var(--text-secondary);
}</script>
<script type="text/plain" id="mo-3">/* Primary Button */
.primary-btn {
  background: var(--accent); color: #fff; border: 1px solid var(--accent);
  padding: 8px 18px; border-radius: 10px; font-size: 0.85rem;
  font-weight: 500; cursor: pointer; display: inline-flex;
  align-items: center; gap: 6px; transition: all 0.15s;
}
.primary-btn:hover {
  background: var(--accent-hover); border-color: var(--accent-hover);
  transform: translateY(-1px); box-shadow: var(--shadow-sm);
}

/* Secondary Button */
.secondary-btn {
  background: var(--surface); color: var(--text-secondary);
  border: 1px solid var(--border); padding: 8px 18px; border-radius: 10px;
  font-size: 0.85rem; font-weight: 500; cursor: pointer;
  display: inline-flex; align-items: center; gap: 6px;
  transition: all 0.15s;
}
.secondary-btn:hover {
  background: var(--surface-2); color: var(--text);
  border-color: var(--text-secondary);
}
.secondary-btn.danger { color: #ef4444; border-color: #fca5a5; }
.secondary-btn.danger:hover { background: rgba(239,68,68,0.08); }</script>
<script type="text/plain" id="mo-4">/* Leaderboard Tabs */
.lb-tabs { display: flex; gap: 8px; margin-bottom: 20px; }
.lb-tab {
  padding: 8px 18px; border-radius: 10px; border: 1px solid var(--border);
  background: var(--surface); color: var(--text-secondary); cursor: pointer;
  font-size: 0.85rem; font-weight: 500; transition: all 0.15s;
}
.lb-tab.active { background: var(--accent); color: #fff; border-color: var(--accent); }
.lb-tab:hover:not(.active) { border-color: var(--accent); color: var(--text); }

/* Leaderboard Table */
.lb-table { width: 100%; border-collapse: collapse; }
.lb-table th { text-align: left; padding: 10px 14px; font-size: 0.78rem;
  color: var(--text-secondary); border-bottom: 1px solid var(--border); }
.lb-row td { padding: 10px 14px; border-bottom: 1px solid var(--border); }
.lb-gold td:first-child { color: #f59e0b; font-weight: 700; }
.lb-silver td:first-child { color: #94a3b8; font-weight: 700; }
.lb-bronze td:first-child { color: #cd7f32; font-weight: 700; }

/* Messages */
.msg-tabs { display: flex; gap: 8px; align-items: center;
  border-bottom: 1px solid var(--border); padding-bottom: 12px; }
.msg-tab { padding: 8px 18px; border-radius: 10px; border: 1px solid var(--border);
  background: var(--surface); color: var(--text-secondary); cursor: pointer; }
.msg-tab.active { background: var(--accent); color: #fff; border-color: var(--accent); }
.msg-compose-btn { /* siehe Yaman */ }
.msg-item { padding: 12px 16px; border-radius: 10px; cursor: pointer;
  border: 1px solid var(--border); margin-bottom: 6px;
  display: grid; grid-template-columns: 1fr 2fr auto; gap: 12px; }
.msg-item:hover { border-color: var(--accent); }
.msg-unread { border-left: 3px solid var(--accent); font-weight: 600; }

/* Profil */
.up-card { background: var(--surface); border: 1px solid var(--border);
  border-radius: 14px; padding: 28px; }
.up-hero { display: flex; align-items: center; gap: 20px; margin-bottom: 24px; }
.up-avatar { width: 64px; height: 64px; border-radius: 50%;
  background: var(--surface-2); display: flex; align-items: center;
  justify-content: center; font-size: 1.5rem; font-weight: 700; color: var(--text-secondary); }
.up-stats { display: grid; grid-template-columns: repeat(4,1fr); gap: 12px; }
.up-stat { text-align: center; padding: 16px; background: var(--surface-2);
  border-radius: 10px; }
.up-stat-value { display: block; font-size: 1.3rem; font-weight: 700; }</script>
