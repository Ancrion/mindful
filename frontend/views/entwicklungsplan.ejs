    <style>
      .plan-page { padding: 40px 48px; max-width: 1200px; }
      .plan-page h1 { font-size: 1.75rem; font-weight: 700; margin: 0; }
      .plan-subtitle { color: var(--text-secondary); font-size: 0.9rem; margin: 4px 0 32px; }

      .plan-summary {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
        gap: 12px; margin-bottom: 36px;
      }
      .plan-stat {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px; padding: 16px 20px; text-align: center;
      }
      .plan-stat strong { display: block; font-size: 1.6rem; }
      .plan-stat span { font-size: 0.78rem; color: var(--text-secondary); }

      .plan-section { margin-bottom: 40px; }
      .plan-section-header {
        display: flex; align-items: center; gap: 14px; margin-bottom: 16px;
        padding-bottom: 12px; border-bottom: 2px solid var(--accent);
      }
      .plan-section-header .avatar {
        width: 36px; height: 36px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-weight: 700; font-size: 0.8rem; color: #fff; flex-shrink: 0;
      }
      .plan-section-header h2 { font-size: 1.2rem; font-weight: 600; margin: 0; }
      .plan-section-header .section-role {
        font-size: 0.75rem; color: var(--text-secondary);
      }
      .plan-section-header .section-count {
        margin-left: auto;
        font-size: 0.72rem; color: var(--text-secondary);
        background: var(--surface-2); padding: 4px 12px; border-radius: 20px;
      }

      .plan-task {
        background: var(--surface);
        border: 1px solid var(--border);
        border-left: 4px solid var(--border);
        border-radius: 10px; padding: 0; margin-bottom: 8px;
        display: grid;
        grid-template-columns: 36px 1fr;
        gap: 0; align-items: start; font-size: 0.85rem;
        transition: border-color 0.15s, opacity 0.2s, transform 0.2s;
        order: 0; overflow: hidden;
        cursor: pointer;
      }
      .plan-task:hover { 
        border-color: var(--accent);
        transform: translateX(2px);
      }
      .plan-task.status-done {
        border-left-color: #10b981; opacity: 0.6;
      }
      .plan-task.status-done:hover { opacity: 0.8; }

      .plan-task .cb-wrap {
        width: 36px; min-height: 100%;
        display: flex; align-items: flex-start; justify-content: center;
        padding: 14px 0 0;
        cursor: pointer; flex-shrink: 0;
        background: transparent; border: none;
        box-sizing: border-box;
      }
      .plan-task .cb-wrap .cb-box {
        width: 20px; height: 20px; border-radius: 6px;
        border: 2px solid var(--border);
        background: var(--surface);
        display: flex; align-items: center; justify-content: center;
        transition: all 0.15s; font-size: 0.6rem;
        color: transparent; flex-shrink: 0;
      }
      .plan-task.status-done .cb-box {
        background: #10b981; border-color: #10b981; color: #fff;
      }

      .plan-task .info {
        padding: 12px 16px 12px 10px; cursor: pointer;
        min-width: 0;
      }
      .plan-task .info .file {
        font-family: var(--font-mono, monospace);
        font-size: 0.75rem; color: var(--accent); margin-bottom: 2px;
      }
      .plan-task .info .title {
        font-weight: 500; color: var(--text); margin-bottom: 2px;
      }
      .plan-task .info .desc { color: var(--text-secondary); line-height: 1.4; font-size: 0.8rem; }
      .plan-task .info .tags {
        margin-top: 6px; display: flex; gap: 6px; flex-wrap: wrap;
      }
      .plan-task .info .tag {
        display: inline-block;
        font-family: var(--font-mono, monospace); font-size: 0.65rem;
        background: var(--surface-2); padding: 2px 8px; border-radius: 6px; 
        color: var(--text-secondary); border: 1px solid var(--border);
      }

      .plan-tasks { display: flex; flex-direction: column; }

      .plan-footer {
        margin-top: 40px; padding: 20px 24px;
        background: var(--surface); border: 1px solid var(--border);
        border-radius: 12px; font-size: 0.85rem;
        color: var(--text-secondary); line-height: 1.6;
      }

      /* ─── CODE MODAL ─── */
      .code-overlay {
        position: fixed; inset: 0; background: rgba(0,0,0,0.5);
        z-index: 9999; display: none;
        align-items: center; justify-content: center;
        padding: 20px;
      }
      .code-overlay.open { display: flex; }
      .code-modal {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 14px;
        max-width: 800px; width: 100%;
        max-height: 85vh;
        display: flex; flex-direction: column;
        box-shadow: 0 20px 60px rgba(0,0,0,0.3);
        overflow: hidden;
      }
      .code-modal-header {
        display: flex; align-items: center; justify-content: space-between;
        padding: 16px 20px;
        border-bottom: 1px solid var(--border);
      }
      .code-modal-header h3 {
        margin: 0; font-size: 0.95rem; font-weight: 600;
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
      }
      .code-modal-close {
        background: none; border: none; color: var(--text-secondary);
        font-size: 1.2rem; cursor: pointer; padding: 4px 8px; border-radius: 6px;
        flex-shrink: 0;
      }
      .code-modal-close:hover { background: var(--surface-2); color: var(--text); }
      .code-modal-body {
        padding: 16px 20px; overflow-y: auto; flex: 1;
      }
      .code-modal-body pre {
        background: #1e1e2e; color: #cdd6f4; border-radius: 10px;
        padding: 16px 18px; font-size: 0.75rem; line-height: 1.5;
        overflow-x: auto; white-space: pre; tab-size: 2;
        margin: 0;
        font-family: 'JetBrains Mono', 'Fira Code', 'Cascadia Code', monospace;
      }
      .code-modal-footer {
        padding: 12px 20px;
        border-top: 1px solid var(--border);
        display: flex; gap: 8px; justify-content: flex-end;
      }
      .code-modal-footer .copy-btn {
        padding: 6px 16px; border-radius: 8px; border: 1px solid var(--border);
        background: var(--surface-2); color: var(--text); font-size: 0.8rem;
        cursor: pointer; font-weight: 500;
      }
      .code-modal-footer .copy-btn:hover { background: var(--accent); color: #fff; border-color: var(--accent); }

      .phase-badge {
        display: inline-block; font-size: 0.65rem;
        background: var(--accent); color: #fff; padding: 2px 10px;
        border-radius: 10px; font-weight: 600; margin-right: 8px;
      }

      @media (max-width: 768px) {
        .plan-page { padding: 20px 16px; }
        .plan-summary { grid-template-columns: repeat(3, 1fr); }
      }
    </style>
  </head>
  <body>
    <div class="app-layout">
      <%- include('partials/sidebar') %>

      <main class="plan-page">
        <header style="margin-bottom:8px">
          <div class="eyebrow">Entwicklungsprozess</div>
          <h1>Projektplan & Implementierungsreferenz</h1>
          <p class="plan-subtitle">
            v1.7.7-Final — Checkbox = erledigt/offen · Task klicken = Code anzeigen · Status in localStorage gespeichert
          </p>
        </header>

        <div class="plan-summary" id="planSummary">
          <div class="plan-stat"><strong id="statTotal">0</strong><span>Tasks gesamt</span></div>
          <div class="plan-stat"><strong id="statDone">0</strong><span>erledigt</span></div>
          <div class="plan-stat"><strong id="statOpen">0</strong><span>offen</span></div>
        </div>

        <div id="planContainer">
          <!-- Wird von JavaScript gerendert -->
        </div>

        <div class="plan-footer">
          <strong>📋 So funktioniert's:</strong><br>
          <strong>Navigation:</strong> Checkbox klicken = Task als erledigt/offen markieren (Status bleibt in localStorage gespeichert, erledigte Tasks wandern nach unten)<br>
          <strong>Code ansehen:</strong> Task-Beschreibung klicken → Code-Modal mit echtem Quellcode öffnet sich. Copy-Button zum schnellen Kopieren.<br>
          <strong>Struktur:</strong> Plan ist in Phasen organisiert. Jede Phase zeigt Implementierungsdatei, relevante Endpoints, und zuständige Person.<br>
          <strong>Rebuild-Referenz:</strong> Diese Seite enthält alle Informationen um die App 1:1 neu zu bauen. Alle gezeigten Snippets sind aus der echten Codebase.
        </div>
      </main>
    </div>

    <!-- ─── CODE MODAL ─── -->
    <div class="code-overlay" id="codeOverlay" onclick="if(event.target===this)closeCodeModal()">
      <div class="code-modal">
        <div class="code-modal-header">
          <h3 id="codeModalTitle">Code Snippet</h3>
          <button class="code-modal-close" onclick="closeCodeModal()"><i class="fas fa-times"></i></button>
        </div>
        <div class="code-modal-body">
          <pre id="codeModalPre"></pre>
        </div>
        <div class="code-modal-footer">
          <button class="copy-btn" onclick="copyCode()"><i class="fas fa-copy"></i> Kopieren</button>
        </div>
      </div>
    </div>

