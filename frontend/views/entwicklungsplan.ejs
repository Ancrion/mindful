<script type="text/plain" id="yaman-3">// In der renderUserList Funktion:
function renderUserList(users) {
  const dd = document.getElementById("msgUserDropdown");
  if (users.length === 0) {
    const q = document.getElementById("msgUserSearch").value.trim();
    dd.innerHTML = q
      ? '<div class="msg-user-opt disabled">Keine Nutzer gefunden</div>'
      : "";
    return;
  }
  dd.innerHTML = users.map(u =>
    \`<div class="msg-user-opt" data-id="\${u.id}"
      onclick="selectUser(\${u.id},'\${escHtml(u.name)}')">\${escHtml(u.name)}</div>\`
  ).join("");
}</script>
