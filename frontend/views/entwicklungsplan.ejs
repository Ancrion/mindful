    <script>
    // ─── Status-Management mit localStorage ───
    const STORAGE_KEY = 'mindful_plan_status';

    function loadAllStatus() {
      try { return JSON.parse(localStorage.getItem(STORAGE_KEY)) || {}; } catch { return {}; }
    }
    function saveAllStatus(map) {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(map));
    }

    function getTaskId(el) {
      while (el && !el.dataset.id) el = el.parentElement;
      return el ? el.dataset.id : null;
    }

    function setStatus(id, value) {
      const map = loadAllStatus();
      map[id] = value;
      saveAllStatus(map);
      renderAll();
    }

    function renderAll() {
      const map = loadAllStatus();
      const tasks = document.querySelectorAll('.plan-task');
      let total = 0, done = 0, wip = 0, open = 0;
      tasks.forEach(t => {
        const id = t.dataset.id;
        const saved = map[id];
        const status = (saved === 'done' || saved === 'wip') ? saved : 'open';
        t.className = 'plan-task status-' + status;
        const sel = t.querySelector('select');
        if (sel) sel.value = status;
        total++;
        if (status === 'done') done++;
        else if (status === 'wip') wip++;
        else open++;
      });
      document.getElementById('statTotal').textContent = total;
      document.getElementById('statDone').textContent = done;
      document.getElementById('statWip').textContent = wip;
      document.getElementById('statOpen').textContent = open;
    }

    document.addEventListener('DOMContentLoaded', renderAll);
    </script>

