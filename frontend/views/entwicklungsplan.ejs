    // ═══════════════════════════════════════════════
    // RENDER & LOGIK
    // ═══════════════════════════════════════════════

    const STORAGE_KEY = 'mindful_plan_status';
    let _currentCodeId = null;

    function loadMap() {
      try { return JSON.parse(localStorage.getItem(STORAGE_KEY)) || {}; } catch { return {}; }
    }
    function saveMap(m) {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(m));
    }

    function toggle(id) {
      const m = loadMap();
      m[id] = m[id] === 'done' ? 'open' : 'done';
      saveMap(m);
      renderAll();
      event.stopPropagation();
    }

    function showCode(taskId) {
      for (const person of Object.values(TASKS)) {
        for (const item of person.items) {
          if (item.id === taskId) {
            _currentCodeId = taskId;
            document.getElementById('codeModalTitle').textContent =
              item.file + ' — ' + item.commit;
            const el = document.getElementById(taskId);
            let code = el ? el.textContent : '// Code nicht gefunden';
            code = code.replace(/\\\//g, '/');
            document.getElementById('codeModalPre').textContent = code;
            document.getElementById('codeOverlay').classList.add('open');
            return;
          }
        }
      }
    }

    function closeCodeModal() {
      document.getElementById('codeOverlay').classList.remove('open');
    }

    function copyCode() {
      const pre = document.getElementById('codeModalPre');
      navigator.clipboard.writeText(pre.textContent).then(() => {
        const btn = document.querySelector('.copy-btn');
        btn.innerHTML = '<i class="fas fa-check"></i> Kopiert!';
        setTimeout(() => {
          btn.innerHTML = '<i class="fas fa-copy"></i> Kopieren';
        }, 2000);
      }).catch(() => {
        showToast('Kopieren fehlgeschlagen', 'error');
      });
    }

    document.addEventListener('keydown', e => {
      if (e.key === 'Escape') closeCodeModal();
    });

    function renderAll() {
      const m = loadMap();
      const container = document.getElementById('planContainer');
      container.innerHTML = '';
      let total = 0, doneCount = 0;

      for (const [key, person] of Object.entries(TASKS)) {
        const section = document.createElement('div');
        section.className = 'plan-section';

        const header = document.createElement('div');
        header.className = 'plan-section-header';
        const icon = person.initial.length === 1
          ? person.initial
          : '<i class="fas fa-users" style="font-size:0.85rem"></i>';
        header.innerHTML = `
          <div class="avatar" style="background:${person.color}">${icon}</div>
          <h2>${person.label}</h2>
          <span class="section-role">${person.role}</span>
          <span class="section-count" id="count-${key}">0/0</span>
        `;
        section.appendChild(header);

        const tasksDiv = document.createElement('div');
        tasksDiv.className = 'plan-tasks';

        const sorted = [...person.items].sort((a, b) => {
          const aDone = m[a.id] === 'done' ? 1 : 0;
          const bDone = m[b.id] === 'done' ? 1 : 0;
          return aDone - bDone;
        });

        let pDone = 0;
        sorted.forEach(item => {
          const status = m[item.id] === 'done' ? 'done' : 'open';
          const task = document.createElement('div');
          task.className = 'plan-task status-' + status;
          task.dataset.id = item.id;

          const cb = document.createElement('div');
          cb.className = 'cb-wrap';
          cb.onclick = function(e) { toggle(item.id); e.stopPropagation(); };
          cb.innerHTML = '<div class="cb-box"><i class="fas fa-check"></i></div>';

          const info = document.createElement('div');
          info.className = 'info';
          info.onclick = function() { showCode(item.id); };
          info.innerHTML = `
            <div class="file">${item.file}</div>
            <div class="desc">${item.desc}</div>
            <div class="commit-msg">${item.commit}</div>
            <span class="hint">👆 Code anzeigen</span>
          `;

          task.appendChild(cb);
          task.appendChild(info);
          tasksDiv.appendChild(task);
          total++;
          if (status === 'done') { doneCount++; pDone++; }
        });

        section.appendChild(tasksDiv);
        container.appendChild(section);

        // update per-person count after rendering
        setTimeout(() => {
          const el = document.getElementById('count-' + key);
          if (el) el.textContent = pDone + '/' + person.items.length;
        }, 0);
      }

      document.getElementById('statTotal').textContent = total;
      document.getElementById('statDone').textContent = doneCount;
      document.getElementById('statOpen').textContent = total - doneCount;
    }

    document.addEventListener('DOMContentLoaded', renderAll);
    </script>
