<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Mindful – Bug-Report</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.svg" />
    <link rel="stylesheet" href="/css/design-system.css?v=<%= Date.now() %>" />
    <link rel="stylesheet" href="/css/style.css?v=<%= Date.now() %>" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
  </head>
  <body>
    <div class="app-layout">
      <%- include('partials/sidebar') %>

      <main class="bugs-main">
        <header class="bugs-header">
          <h1>Bug-<span>Report</span></h1>
          <p class="subtitle">Melde Fehler und verfolge den Status aller eingereichten Bugs.</p>
        </header>

        <div class="bugs-content">
          <form id="bugForm" class="bug-form">
            <div class="bug-form-header">
              <span class="bug-form-icon"><i class="fas fa-bug"></i></span>
              <span>Neuen Fehler melden</span>
            </div>
            <div class="bug-form-body">
              <div class="bug-form-main">
                <input type="text" id="bugTitle" placeholder="Kurze Zusammenfassung des Fehlers …" required />
                <select id="bugSeite" class="bug-select">
                  <option value="">Betroffene Seite</option>
                  <option value="Dashboard">Dashboard</option>
                  <option value="To-Do">To-Do</option>
                  <option value="Notizen">Notizen</option>
                  <option value="Kalender">Kalender</option>
                  <option value="Pomodoro">Pomodoro</option>
                  <option value="Zeiterfassung">Zeiterfassung</option>
                  <option value="Rangliste">Rangliste</option>
                  <option value="Nachrichten">Nachrichten</option>
                  <option value="Profil">Profil</option>
                  <option value="Projektplan">Projektplan</option>
                  <option value="Bugs">Bugs</option>
                  <option value="Versionsverlauf">Versionsverlauf</option>
                </select>
              </div>
              <textarea id="bugDesc" placeholder="Genauere Beschreibung (optional) …" rows="2"></textarea>
              <div class="bug-form-footer">
                <button type="submit" class="primary-btn"><i class="fas fa-paper-plane"></i> Senden</button>
              </div>
            </div>
          </form>

          <div class="kanban" id="kanban">
            <div class="kanban-col" data-status="offen">
              <div class="kanban-col-header offen">
                <span class="kanban-col-dot"></span>
                Offen
                <span class="kanban-count" id="count-offen">0</span>
              </div>
              <div class="kanban-cards" id="col-offen"></div>
            </div>
            <div class="kanban-col" data-status="in_arbeit">
              <div class="kanban-col-header in-arbeit">
                <span class="kanban-col-dot"></span>
                In Arbeit
                <span class="kanban-count" id="count-in_arbeit">0</span>
              </div>
              <div class="kanban-cards" id="col-in_arbeit"></div>
            </div>
            <div class="kanban-col" data-status="abgeschlossen">
              <div class="kanban-col-header abgeschlossen">
                <span class="kanban-col-dot"></span>
                Abgeschlossen
                <span class="kanban-count" id="count-abgeschlossen">0</span>
              </div>
              <div class="kanban-cards" id="col-abgeschlossen"></div>
            </div>
          </div>
        </div>
      </main>
    </div>

    <script src="/js/app.js?v=<%= Date.now() %>"></script>
    <script src="/js/bugs.js?v=<%= Date.now() %>"></script>
  </body>
</html>
