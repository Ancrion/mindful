<!DOCTYPE html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard - Mindful</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.svg" />
    <link rel="stylesheet" href="/css/style.css" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"
    />
    <style>
      .dashboard {
        padding: 40px;
        max-width: 1200px;
        margin: 0 auto;
      }
      .dashboard h1 {
        color: var(--text);
        margin-bottom: 30px;
        font-size: 40px;
      }
      .dashboard h1 span {
        color: var(--accent);
      }
      .stats-container {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-bottom: 40px;
      }
      .stat-card {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 20px;
        border-radius: 8px;
        text-align: center;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        cursor: pointer;
        transition: transform 0.15s, box-shadow 0.15s;
      }
      .stat-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 12px rgba(0, 0, 0, 0.15);
      }
      .stat-card h3 {
        margin: 0 0 10px 0;
        font-size: 14px;
        opacity: 0.9;
      }
      .stat-card .number {
        font-size: 32px;
        font-weight: bold;
      }
      .quick-actions {
        display: flex;
        gap: 10px;
        margin-bottom: 40px;
      }
      .btn {
        padding: 10px 20px;
        background-color: #667eea;
        color: white;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        text-decoration: none;
        display: inline-block;
        font-size: 14px;
      }
      .btn:hover {
        background-color: #5568d3;
      }
      .logout-btn {
        background-color: #ef4444;
      }
      .logout-btn:hover {
        background-color: #dc2626;
      }

      /* ── Upcoming Events ── */
      .dash-section-title {
        font-size: 18px;
        font-weight: 600;
        color: var(--text);
        margin-bottom: 12px;
      }
      .dash-event-list {
        display: flex;
        flex-direction: column;
        gap: 6px;
      }
      .dash-event {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 14px;
        background: var(--surface);
        border: 1px solid var(--border-soft);
        border-radius: 8px;
        cursor: context-menu;
        transition: background 0.1s;
      }
      .dash-event:hover {
        background: var(--surface-2);
      }
      .dash-event .de-color {
        width: 4px;
        height: 32px;
        border-radius: 3px;
        flex-shrink: 0;
      }
      .dash-event .de-info {
        flex: 1;
        min-width: 0;
      }
      .dash-event .de-title {
        font-size: 14px;
        font-weight: 500;
        color: var(--text);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .dash-event .de-meta {
        font-size: 12px;
        color: var(--text-secondary);
        margin-top: 2px;
      }
      .dash-event .de-date {
        font-size: 12px;
        color: var(--text-secondary);
        white-space: nowrap;
        text-align: right;
      }
      .dash-empty {
        text-align: center;
        padding: 24px;
        color: var(--text-secondary);
        font-size: 14px;
      }
    </style>
  </head>
  <body>
    <div class="app-layout">
      <%- include('partials/sidebar') %>
      <div class="dashboard">
        <div
          style="
            display: flex;
            justify-content: space-between;
            align-items: center;
          "
        >
          <h1><span>Dashboard</span></h1>
          <button class="btn logout-btn" onclick="logout()">Abmelden</button>
        </div>

        <div class="stats-container">
          <div class="stat-card">
            <h3>Todos</h3>
            <div class="number" id="todo-count">0</div>
          </div>
          <div class="stat-card">
            <h3>Notizen</h3>
            <div class="number" id="note-count">0</div>
          </div>
          <div class="stat-card">
            <h3>Events</h3>
            <div class="number" id="event-count">0</div>
          </div>
          <div class="stat-card">
            <h3>Dokumente</h3>
            <div class="number" id="doc-count">0</div>
          </div>
        </div>

        <div class="quick-actions">
          <a href="/todo" class="btn">Neues Todo</a>
          <a href="/notizen" class="btn">Neue Notiz</a>
          <a href="/kalender" class="btn">Events</a>
          <a href="/dokumente" class="btn">Dokumente</a>
        </div>

        <div class="dash-section-title">Anstehende Termine</div>
        <div class="dash-event-list" id="dashEventList">
          <div class="dash-empty">Wird geladen…</div>
        </div>
      </div>
    </div>

    <div class="ctx-menu" id="ctxMenu">
      <div class="ctx-item" data-action="edit"><i class="fas fa-pencil-alt"></i> Bearbeiten</div>
      <div class="ctx-item ctx-danger" data-action="delete"><i class="fas fa-trash"></i> Löschen</div>
    </div>

    <script>
      let ctxEventId = null;

      function fmtDate(d) {
        const dd = new Date(d);
        return `${String(dd.getDate()).padStart(2,"0")}.${String(dd.getMonth()+1).padStart(2,"0")}.${dd.getFullYear()}`;
      }
      function fmtTime(d) {
        const dd = new Date(d);
        return `${String(dd.getHours()).padStart(2,"0")}:${String(dd.getMinutes()).padStart(2,"0")}`;
      }

      function showEventCtxMenu(e, ev) {
        e.preventDefault();
        e.stopPropagation();
        closeCtxMenu();
        ctxEventId = ev.id;

        const menu = document.getElementById("ctxMenu");
        menu.querySelector('[data-action="edit"]').onclick = () => {
          closeCtxMenu();
          window.location.href = "/kalender";
        };
        menu.querySelector('[data-action="delete"]').onclick = async () => {
          closeCtxMenu();
          try {
            await fetch(`/api/events/${ev.id}`, { method: "DELETE" });
            renderUpcoming();
          } catch (err) {
            console.error("Fehler beim Löschen:", err);
          }
        };

        const x = Math.min(e.clientX, window.innerWidth - menu.offsetWidth - 8);
        const y = Math.min(e.clientY, window.innerHeight - menu.offsetHeight - 8);
        menu.style.left = x + "px";
        menu.style.top = y + "px";
        menu.classList.add("open");
      }

      function closeCtxMenu() {
        const menu = document.getElementById("ctxMenu");
        if (menu) menu.classList.remove("open");
        ctxEventId = null;
      }

      async function loadDashboardData() {
        try {
          const response = await fetch("/api/dashboard");
          if (!response.ok) throw new Error("Fehler beim Laden der Daten");

          const data = await response.json();
          document.getElementById("todo-count").textContent = (data.todos || []).length;
          document.getElementById("note-count").textContent = (data.notizen || []).length;
          document.getElementById("event-count").textContent = (data.events || []).length;
          document.getElementById("doc-count").textContent = (data.dokumente || []).length;

          if (data.user) {
            const els = {
              userNameDisplay: data.user.name,
              userInitials: data.user.name.split(" ").map((n) => n[0]).join("").toUpperCase().substring(0, 2),
            };
            Object.keys(els).forEach((id) => {
              const el = document.getElementById(id);
              if (el) el.textContent = els[id];
            });
          }

          window._allEvents = data.events || [];
          renderUpcoming();
        } catch (err) {
          console.error("Dashboard Fehler:", err);
        }
      }

      function renderUpcoming() {
        const list = document.getElementById("dashEventList");
        const events = window._allEvents || [];
        const now = new Date();

        const upcoming = events
          .filter(e => e.start_datum && new Date(e.start_datum) >= new Date(now.getFullYear(), now.getMonth(), now.getDate()))
          .sort((a, b) => new Date(a.start_datum) - new Date(b.start_datum))
          .slice(0, 10);

        if (upcoming.length === 0) {
          list.innerHTML = '<div class="dash-empty">Keine anstehenden Termine</div>';
          return;
        }

        window._eventIndex = {};
        list.innerHTML = upcoming.map(ev => {
          window._eventIndex[ev.id] = ev;
          const start = new Date(ev.start_datum);
          const color = ev.farbe || "#3B82F6";
          const dateStr = fmtDate(start);
          const timeStr = ev.ganztag ? "Ganztägig" : fmtTime(start);
          return `<div class="dash-event" data-id="${ev.id}">
            <div class="de-color" style="background:${color}"></div>
            <div class="de-info">
              <div class="de-title">${ev.titel}</div>
              <div class="de-meta">${timeStr}${ev.ort ? " · " + ev.ort : ""}</div>
            </div>
            <div class="de-date">${dateStr}</div>
          </div>`;
        }).join("");
      }

      async function logout() {
        try {
          await fetch("/api/auth/logout", { method: "POST" });
          window.location.href = "/";
        } catch (err) {
          console.error("Fehler beim Abmelden:", err);
        }
      }

      // Event delegation for right-click on upcoming events
      document.addEventListener("contextmenu", function(e) {
        const eventEl = e.target.closest(".dash-event");
        if (eventEl) {
          const id = parseInt(eventEl.dataset.id);
          const ev = window._eventIndex && window._eventIndex[id];
          if (ev) showEventCtxMenu(e, ev);
        } else {
          closeCtxMenu();
        }
      });
      document.addEventListener("click", function(e) {
        if (!e.target.closest(".ctx-menu") && !e.target.closest(".dash-event")) closeCtxMenu();
      });

      loadDashboardData();
    </script>
  </body>
</html>
