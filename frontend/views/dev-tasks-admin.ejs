<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Mindful – Entwicklungsaufgaben Admin</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.svg" />
    <link rel="stylesheet" href="/css/design-system.css?v=<%= Date.now() %>" />
    <link rel="stylesheet" href="/css/components.css?v=<%= Date.now() %>" />
    <link rel="stylesheet" href="/css/layout-components.css?v=<%= Date.now() %>" />
    <link rel="stylesheet" href="/css/animations.css?v=<%= Date.now() %>" />
    <link rel="stylesheet" href="/css/polish.css?v=<%= Date.now() %>" />
    <link rel="stylesheet" href="/css/accessibility.css?v=<%= Date.now() %>" />
    <link rel="stylesheet" href="/css/style.css?v=<%= Date.now() %>" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"
    />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.8.0/styles/atom-one-dark.min.css" />
    <style>
      .dev-tasks-admin {
        padding: 40px 48px;
        max-width: 1400px;
        margin: 0 auto;
      }

      .admin-header {
        margin-bottom: 40px;
      }

      .admin-header h1 {
        font-size: 1.75rem;
        font-weight: 700;
        margin: 0;
      }

      .admin-header p {
        color: var(--text-secondary);
        margin: 8px 0 0;
        font-size: 0.9rem;
      }

      .admin-tabs {
        display: flex;
        gap: 8px;
        margin-bottom: 32px;
        border-bottom: 2px solid var(--border);
      }

      .admin-tab {
        padding: 12px 20px;
        background: none;
        border: none;
        font-size: 0.9rem;
        font-weight: 500;
        color: var(--text-secondary);
        cursor: pointer;
        position: relative;
        transition: color 0.2s;
      }

      .admin-tab:hover {
        color: var(--text-primary);
      }

      .admin-tab.active {
        color: var(--accent);
      }

      .admin-tab.active::after {
        content: '';
        position: absolute;
        bottom: -2px;
        left: 0;
        right: 0;
        height: 2px;
        background: var(--accent);
      }

      .admin-section {
        display: none;
      }

      .admin-section.active {
        display: block;
      }

      /* Task Form */
      .task-form {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 24px;
        margin-bottom: 32px;
      }

      .form-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 16px;
        margin-bottom: 16px;
      }

      .form-group {
        display: flex;
        flex-direction: column;
      }

      .form-group.full {
        grid-column: 1 / -1;
      }

      .form-group label {
        font-size: 0.85rem;
        font-weight: 500;
        margin-bottom: 6px;
        color: var(--text-primary);
      }

      .form-group input,
      .form-group textarea,
      .form-group select {
        padding: 10px 12px;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: var(--surface-2);
        color: var(--text-primary);
        font-size: 0.9rem;
        font-family: inherit;
        transition: border-color 0.2s, box-shadow 0.2s;
      }

      .form-group input:focus,
      .form-group textarea:focus,
      .form-group select:focus {
        outline: none;
        border-color: var(--accent);
        box-shadow: 0 0 0 3px var(--accent-dim);
      }

      .form-group textarea {
        resize: vertical;
        min-height: 100px;
      }

      .form-actions {
        display: flex;
        gap: 12px;
        justify-content: flex-end;
        margin-top: 20px;
        padding-top: 20px;
        border-top: 1px solid var(--border);
      }

      .btn {
        padding: 10px 20px;
        border: none;
        border-radius: 8px;
        font-size: 0.9rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s;
      }

      .btn-primary {
        background: var(--accent);
        color: #fff;
      }

      .btn-primary:hover {
        opacity: 0.9;
      }

      .btn-secondary {
        background: var(--surface-2);
        color: var(--text-primary);
        border: 1px solid var(--border);
      }

      .btn-secondary:hover {
        background: var(--border);
      }

      .btn-danger {
        background: #ef4444;
        color: #fff;
      }

      .btn-danger:hover {
        opacity: 0.9;
      }

      /* Code Preview */
      .code-preview {
        background: var(--surface-2);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 16px;
        margin-top: 12px;
        max-height: 300px;
        overflow: auto;
      }

      .code-preview pre {
        margin: 0;
        font-size: 0.8rem;
      }

      .code-preview code {
        color: var(--text-secondary);
      }

      /* Tasks List */
      .tasks-list {
        display: grid;
        gap: 12px;
      }

      .task-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 16px;
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 16px;
        align-items: start;
      }

      .task-card-title {
        font-weight: 600;
        color: var(--text-primary);
        margin-bottom: 6px;
      }

      .task-card-meta {
        display: flex;
        gap: 12px;
        font-size: 0.8rem;
        color: var(--text-secondary);
        margin-bottom: 8px;
        flex-wrap: wrap;
      }

      .task-badge {
        background: var(--accent-dim);
        color: var(--accent);
        padding: 2px 8px;
        border-radius: 4px;
        font-size: 0.75rem;
        font-weight: 500;
      }

      .task-card-actions {
        display: flex;
        gap: 8px;
      }

      .btn-small {
        padding: 6px 12px;
        font-size: 0.8rem;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        transition: all 0.2s;
        background: var(--surface-2);
        color: var(--text-primary);
      }

      .btn-small:hover {
        background: var(--border);
      }

      .btn-small.danger {
        background: #fee2e2;
        color: #dc2626;
      }

      .btn-small.danger:hover {
        background: #fecaca;
      }

      /* Stats */
      .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 12px;
        margin-bottom: 32px;
      }

      .stat-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 16px;
        text-align: center;
      }

      .stat-card strong {
        display: block;
        font-size: 1.6rem;
        color: var(--accent);
        margin-bottom: 4px;
      }

      .stat-card span {
        font-size: 0.8rem;
        color: var(--text-secondary);
      }

      .no-tasks {
        text-align: center;
        padding: 40px 20px;
        color: var(--text-secondary);
      }

      .loading {
        text-align: center;
        padding: 20px;
        color: var(--text-secondary);
      }

      .error-message {
        background: #fee2e2;
        color: #dc2626;
        padding: 12px 16px;
        border-radius: 8px;
        margin-bottom: 16px;
        border-left: 4px solid #dc2626;
      }

      .success-message {
        background: #d1fae5;
        color: #047857;
        padding: 12px 16px;
        border-radius: 8px;
        margin-bottom: 16px;
        border-left: 4px solid #047857;
      }

      /* Line Range Selector */
      .line-range {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
      }

      .line-range input {
        width: 100%;
      }

      /* Response Alert */
      .response-alert {
        display: none;
        padding: 12px 16px;
        border-radius: 8px;
        margin-bottom: 16px;
        border-left: 4px solid;
      }

      .response-alert.success {
        background: #d1fae5;
        color: #047857;
        border-color: #047857;
        display: block;
      }

      .response-alert.error {
        background: #fee2e2;
        color: #dc2626;
        border-color: #dc2626;
        display: block;
      }
    </style>
  </head>
  <body>
    <%- include('components/sidebar.ejs', { currentPage }) %>

    <main class="app-main">
      <%- include('components/navbar.ejs', { currentPage }) %>

      <div class="dev-tasks-admin">
        <div class="admin-header">
          <h1>📋 Entwicklungsaufgaben Management</h1>
          <p>Erstelle, bearbeite und verwalte Entwicklungsaufgaben für alle Projektmitglieder</p>
        </div>

        <div class="admin-tabs">
          <button class="admin-tab active" data-tab="create">Neue Aufgabe</button>
          <button class="admin-tab" data-tab="list">Alle Aufgaben</button>
          <button class="admin-tab" data-tab="stats">Statistiken</button>
        </div>

        <div id="response-alert" class="response-alert"></div>

        <!-- CREATE TAB -->
        <div id="create-tab" class="admin-section active">
          <div class="task-form">
            <h2 style="margin-top: 0; margin-bottom: 20px;">Neue Aufgabe erstellen</h2>
            
            <div class="form-grid">
              <div class="form-group full">
                <label for="title">Titel *</label>
                <input type="text" id="title" placeholder="z.B. Dashboard Widget implementieren" />
              </div>

              <div class="form-group full">
                <label for="description">Beschreibung</label>
                <textarea id="description" placeholder="Detaillierte Beschreibung der Aufgabe..."></textarea>
              </div>

              <div class="form-group full">
                <label for="file-path">Dateipfad *</label>
                <input type="text" id="file-path" placeholder="z.B. backend/routes/todos.js" />
                <small style="color: var(--text-secondary); margin-top: 4px;">Relativer Pfad vom Projekt-Root</small>
              </div>

              <div class="form-group">
                <label for="line-start">Startzeile</label>
                <input type="number" id="line-start" placeholder="z.B. 10" min="1" />
              </div>

              <div class="form-group">
                <label for="line-end">Endzeile</label>
                <input type="number" id="line-end" placeholder="z.B. 50" min="1" />
              </div>

              <div class="form-group">
                <label for="action-type">Aktion</label>
                <select id="action-type">
                  <option value="add">Hinzufügen</option>
                  <option value="modify">Ändern</option>
                  <option value="delete">Löschen</option>
                  <option value="refactor">Umgestalten</option>
                </select>
              </div>

              <div class="form-group">
                <label for="assignee">Zugewiesen an</label>
                <select id="assignee">
                  <option value="">-- Nicht zugewiesen --</option>
                  <option value="ilhan">ilhan</option>
                  <option value="jaro">jaro</option>
                  <option value="team">Team</option>
                </select>
              </div>

              <div class="form-group">
                <label for="status">Status</label>
                <select id="status">
                  <option value="open">Offen</option>
                  <option value="in_progress">In Arbeit</option>
                  <option value="done">Erledigt</option>
                </select>
              </div>

              <div class="form-group">
                <label for="priority">Priorität</label>
                <select id="priority">
                  <option value="low">Niedrig</option>
                  <option value="medium">Mittel</option>
                  <option value="high">Hoch</option>
                </select>
              </div>

              <div class="form-group">
                <label for="phase">Phase</label>
                <select id="phase">
                  <option value="Phase 1">Phase 1</option>
                  <option value="Phase 2">Phase 2</option>
                  <option value="Phase 3">Phase 3</option>
                  <option value="Phase 4">Phase 4</option>
                  <option value="Phase 5">Phase 5</option>
                </select>
              </div>
            </div>

            <div id="code-preview-container"></div>

            <div class="form-actions">
              <button class="btn btn-secondary" onclick="resetForm()">Zurücksetzen</button>
              <button class="btn btn-primary" onclick="submitTask()">Aufgabe erstellen</button>
            </div>
          </div>
        </div>

        <!-- LIST TAB -->
        <div id="list-tab" class="admin-section">
          <h2 style="margin-top: 0; margin-bottom: 20px;">Alle Aufgaben</h2>
          
          <div id="tasks-list-container" class="tasks-list">
            <div class="loading">Aufgaben werden geladen...</div>
          </div>
        </div>

        <!-- STATS TAB -->
        <div id="stats-tab" class="admin-section">
          <h2 style="margin-top: 0; margin-bottom: 20px;">Statistiken</h2>
          
          <div id="stats-container" class="stats-grid">
            <div class="loading">Statistiken werden geladen...</div>
          </div>
        </div>
      </div>
    </main>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.8.0/highlight.min.js"></script>
    <script>
      // Tab switching
      document.querySelectorAll('.admin-tab').forEach(tab => {
        tab.addEventListener('click', () => {
          const tabName = tab.dataset.tab;
          
          // Update active tab
          document.querySelectorAll('.admin-tab').forEach(t => t.classList.remove('active'));
          tab.classList.add('active');
          
          // Update active section
          document.querySelectorAll('.admin-section').forEach(s => s.classList.remove('active'));
          document.getElementById(tabName + '-tab').classList.add('active');

          // Load data for specific tabs
          if (tabName === 'list') {
            loadTasks();
          } else if (tabName === 'stats') {
            loadStats();
          }
        });
      });

      // Show response message
      function showResponse(message, isSuccess = true) {
        const alert = document.getElementById('response-alert');
        alert.textContent = message;
        alert.className = 'response-alert ' + (isSuccess ? 'success' : 'error');
        setTimeout(() => alert.className = 'response-alert', 5000);
      }

      // Preview code when file path changes
      document.getElementById('file-path').addEventListener('change', previewCode);
      document.getElementById('line-start').addEventListener('change', previewCode);
      document.getElementById('line-end').addEventListener('change', previewCode);

      async function previewCode() {
        const filePath = document.getElementById('file-path').value;
        const lineStart = document.getElementById('line-start').value || null;
        const lineEnd = document.getElementById('line-end').value || null;

        if (!filePath) {
          document.getElementById('code-preview-container').innerHTML = '';
          return;
        }

        try {
          const response = await fetch(`/api/development-tasks?file_path=${encodeURIComponent(filePath)}`);
          // For preview, we'll just show a placeholder since we don't have a dedicated preview endpoint
          document.getElementById('code-preview-container').innerHTML = `
            <div class="code-preview">
              <p style="margin: 0; color: var(--text-secondary); font-size: 0.85rem;">
                Code-Vorschau wird geladen... (Datei: ${filePath}${lineStart && lineEnd ? ` [Zeilen ${lineStart}-${lineEnd}]` : ''})
              </p>
            </div>
          `;
        } catch (err) {
          document.getElementById('code-preview-container').innerHTML = '';
        }
      }

      // Reset form
      function resetForm() {
        document.getElementById('title').value = '';
        document.getElementById('description').value = '';
        document.getElementById('file-path').value = '';
        document.getElementById('line-start').value = '';
        document.getElementById('line-end').value = '';
        document.getElementById('action-type').value = 'modify';
        document.getElementById('assignee').value = '';
        document.getElementById('status').value = 'open';
        document.getElementById('priority').value = 'medium';
        document.getElementById('phase').value = 'Phase 1';
        document.getElementById('code-preview-container').innerHTML = '';
      }

      // Submit task
      async function submitTask() {
        const task = {
          title: document.getElementById('title').value,
          description: document.getElementById('description').value,
          file_path: document.getElementById('file-path').value,
          line_start: document.getElementById('line-start').value ? parseInt(document.getElementById('line-start').value) : null,
          line_end: document.getElementById('line-end').value ? parseInt(document.getElementById('line-end').value) : null,
          action_type: document.getElementById('action-type').value,
          assignee: document.getElementById('assignee').value || null,
          status: document.getElementById('status').value,
          priority: document.getElementById('priority').value,
          phase: document.getElementById('phase').value
        };

        if (!task.title || !task.file_path) {
          showResponse('Titel und Dateipfad sind erforderlich!', false);
          return;
        }

        try {
          const response = await fetch('/api/development-tasks', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(task)
          });

          const data = await response.json();
          
          if (!response.ok) {
            showResponse(`Fehler: ${data.error || 'Aufgabe konnte nicht erstellt werden'}`, false);
            return;
          }

          showResponse('Aufgabe erfolgreich erstellt! ✅');
          resetForm();
        } catch (err) {
          showResponse(`Fehler: ${err.message}`, false);
        }
      }

      // Load and display tasks
      async function loadTasks() {
        try {
          const response = await fetch('/api/development-tasks');
          const tasks = await response.json();

          const container = document.getElementById('tasks-list-container');

          if (!tasks.length) {
            container.innerHTML = '<div class="no-tasks">Keine Aufgaben gefunden</div>';
            return;
          }

          container.innerHTML = tasks.map(task => `
            <div class="task-card">
              <div>
                <div class="task-card-title">${escapeHtml(task.title)}</div>
                <div class="task-card-meta">
                  <span>
                    <i class="fas fa-file"></i> ${escapeHtml(task.file_path)}
                    ${task.line_start ? ` [${task.line_start}:${task.line_end}]` : ''}
                  </span>
                  ${task.assignee ? `<span><i class="fas fa-user"></i> ${escapeHtml(task.assignee)}</span>` : ''}
                  <span class="task-badge">${escapeHtml(task.status)}</span>
                  <span class="task-badge">${escapeHtml(task.priority)}</span>
                  <span class="task-badge">${escapeHtml(task.phase)}</span>
                </div>
                ${task.description ? `<p style="margin: 8px 0 0; font-size: 0.85rem; color: var(--text-secondary);">${escapeHtml(task.description)}</p>` : ''}
              </div>
              <div class="task-card-actions">
                <button class="btn-small" onclick="editTask(${task.id})">Bearbeiten</button>
                <button class="btn-small danger" onclick="deleteTask(${task.id})">Löschen</button>
              </div>
            </div>
          `).join('');
        } catch (err) {
          document.getElementById('tasks-list-container').innerHTML = 
            `<div class="error-message">Fehler beim Laden der Aufgaben: ${err.message}</div>`;
        }
      }

      // Load statistics
      async function loadStats() {
        try {
          const response = await fetch('/api/development-tasks/stats/summary');
          const stats = await response.json();

          const container = document.getElementById('stats-container');
          
          let html = `
            <div class="stat-card">
              <strong>${stats.total}</strong>
              <span>Gesamt</span>
            </div>
            <div class="stat-card">
              <strong>${stats.open}</strong>
              <span>Offen</span>
            </div>
            <div class="stat-card">
              <strong>${stats.in_progress}</strong>
              <span>In Arbeit</span>
            </div>
            <div class="stat-card">
              <strong>${stats.done}</strong>
              <span>Erledigt</span>
            </div>
          `;

          if (stats.by_assignee && stats.by_assignee.length) {
            html += '<div style="grid-column: 1/-1; margin-top: 20px;"><h3 style="margin: 0 0 12px;">Aufgaben pro Bearbeiter</h3>';
            stats.by_assignee.forEach(a => {
              html += `
                <div class="stat-card" style="grid-column: auto;">
                  <strong>${a.count}</strong>
                  <span>${escapeHtml(a.assignee)}</span>
                  <small style="color: var(--text-secondary); display: block; margin-top: 4px;">
                    Offen: ${a.open}, In Arbeit: ${a.in_progress}, Erledigt: ${a.done}
                  </small>
                </div>
              `;
            });
            html += '</div>';
          }

          container.innerHTML = html;
        } catch (err) {
          document.getElementById('stats-container').innerHTML = 
            `<div class="error-message" style="grid-column: 1/-1;">Fehler beim Laden der Statistiken: ${err.message}</div>`;
        }
      }

      // Edit task (placeholder)
      async function editTask(id) {
        alert('Edit-Funktionalität wird noch implementiert. Task ID: ' + id);
      }

      // Delete task
      async function deleteTask(id) {
        if (!confirm('Aufgabe wirklich löschen?')) return;

        try {
          const response = await fetch(`/api/development-tasks/${id}`, {
            method: 'DELETE'
          });

          if (!response.ok) {
            const data = await response.json();
            showResponse(`Fehler: ${data.error || 'Aufgabe konnte nicht gelöscht werden'}`, false);
            return;
          }

          showResponse('Aufgabe gelöscht! ✅');
          loadTasks();
        } catch (err) {
          showResponse(`Fehler: ${err.message}`, false);
        }
      }

      // Escape HTML
      function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
      }
    </script>
  </body>
</html>
