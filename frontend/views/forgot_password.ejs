<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Mindful – Passwort vergessen</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.svg" />
    <link rel="stylesheet" href="/css/login.css?v=<%= Date.now() %>" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
  </head>
  <body>
    <main class="auth-shell">
      <section class="auth-showcase">
        <div class="showcase-inner">
          <div class="brand-mark">
            <span class="brand-dot"></span>
            <span class="brand-name">MINDFUL</span>
          </div>
          <div class="showcase-copy">
            <h1>Passwort vergessen?</h1>
            <p class="lead">Gib deine E-Mail-Adresse ein, wir schicken dir einen Link zum Zurücksetzen.</p>
          </div>
        </div>
      </section>

      <section class="auth-panel-wrap">
        <div class="auth-panel">
          <div class="auth-panel-head">
            <h2>Passwort zurücksetzen</h2>
            <p>Gib die E-Mail-Adresse ein, mit der du dich registriert hast.</p>
          </div>

          <form id="forgotForm" class="auth-form active">
            <div class="form-group">
              <label>E-Mail-Adresse</label>
              <div class="input-shell">
                <i class="fa-regular fa-envelope"></i>
                <input type="email" id="forgotEmail" placeholder="deine@email.de" required />
              </div>
            </div>
            <button type="submit" class="primary-btn">Link senden</button>
            <div style="text-align:center;margin-top:16px">
              <a href="/login" class="forgot-link">Zurück zum Login</a>
            </div>
          </form>

          <div id="authMessage" class="auth-message"></div>
        </div>
      </section>
    </main>

    <script>
      if (localStorage.getItem("darkMode") === "1" ||
          (!localStorage.getItem("darkMode") && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
        document.body.classList.add("dark");
      }
    </script>
    <script>
      document.getElementById("forgotForm").addEventListener("submit", async (e) => {
        e.preventDefault();
        const email = document.getElementById("forgotEmail").value;
        const msgEl = document.getElementById("authMessage");

        try {
          const res = await fetch("/api/auth/forgot-password", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ email }),
          });
          const data = await res.json();
          msgEl.textContent = data.message || data.error;
          msgEl.className = "auth-message " + (res.ok ? "success" : "error");
        } catch (err) {
          msgEl.textContent = "Fehler bei der Anfrage";
          msgEl.className = "auth-message error";
        }
      });
    </script>
  </body>
</html>
