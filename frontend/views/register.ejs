<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Mindful – Registrieren</title>
    <!-- Pfad auf /css/ angepasst -->
    <link rel="stylesheet" href="/css/register.css?v=<%= Date.now() %>" />
  </head>
  <body>
    <div class="auth-layout">
      <!-- Linke Seite: Branding & Info -->
      <section class="auth-brand">
        <div class="brand-top">
          <h1>MINDFUL<span>.</span></h1>
          <p>EST. 2024</p>
        </div>

        <div class="brand-content">
          <h2>Deine <span>digitale</span><br />Ruheoase.</h2>
          <p class="brand-text">
            Vereine deine Termine, Aufgaben und Gedanken in einem System, das
            für Klarheit sorgt statt für Ablenkung.
          </p>
          <div class="brand-list">
            <p><span>→</span> KALENDER & TASKS</p>
            <p><span>→</span> SMART NOTES</p>
            <p><span>→</span> DOCUMENT HUB</p>
          </div>
        </div>

        <div class="brand-footer">
          <p>DESIGNED FOR FOCUS</p>
        </div>
      </section>

      <!-- Rechte Seite: Registrierungs-Formular -->
      <main class="auth-panel">
        <div class="language-switch">
          <button class="lang-btn active">DE</button>
          <button class="lang-btn">EN</button>
        </div>

        <div class="auth-box">
          <p class="auth-label">JOIN THE COMMUNITY</p>
          <h2>Registrieren<span>.</span></h2>

          <form class="auth-form" id="registerForm">
            <div class="form-group">
              <label for="regName">BENUTZERNAME</label>
              <input
                type="text"
                id="regName"
                placeholder="Max Mustermann"
                required
              />
            </div>

            <div class="form-group">
              <label for="regPassword">PASSWORT</label>
              <input
                type="password"
                id="regPassword"
                placeholder="••••••••"
                required
              />
            </div>

            <!-- Nachrichten-Box für Fehler oder Erfolg -->
            <div
              id="errorMessage"
              style="
                color: #f24b3d;
                font-size: 14px;
                margin-bottom: 15px;
                display: none;
              "
            ></div>

            <button type="submit" class="auth-btn">KONTO ERSTELLEN</button>
          </form>

          <p class="switch-text">
            Bereits Mitglied? <a href="/login">Hier einloggen</a>
          </p>
        </div>
      </main>
    </div>

    <!-- Pfad auf /js/ angepasst -->
    <script src="/js/register.js?v=<%= Date.now() %>"></script>
  </body>
</html>
