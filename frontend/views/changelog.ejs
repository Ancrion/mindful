<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Mindful – Versionsverlauf</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.svg" />
    <link rel="stylesheet" href="/css/style.css?v=<%= Date.now() %>" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
  </head>
  <body>
    <div class="app-layout">
      <%- include('partials/sidebar') %>

      <main class="changelog-main">
        <header class="changelog-header">
          <h1>Versions<span>verlauf</span></h1>
          <p class="subtitle">Alle Änderungen und Neuerungen in Mindful.</p>
          <button id="clAddBtn" class="primary-btn" style="display:none;width:auto;padding:0 20px;height:38px;margin-top:12px">
            <i class="fas fa-plus"></i> Eintrag hinzufügen
          </button>
        </header>

        <div class="changelog-timeline" id="changelogTimeline">
          <p class="loading">Lade Versionsverlauf …</p>
        </div>
      </main>

      <!-- Modal: Eintrag erstellen/bearbeiten -->
      <div class="cl-modal-overlay" id="clModal">
        <div class="cl-modal">
          <button class="cl-modal-close" onclick="closeClModal()">&times;</button>
          <h2 id="clModalTitle">Neuer Eintrag</h2>
          <form id="clForm" onsubmit="saveClEntry(event)">
            <div class="cl-form-row">
              <input type="text" id="clVersion" placeholder="z.B. 1.3.0" required />
              <input type="date" id="clDatum" required />
            </div>
            <input type="text" id="clTitel" placeholder="Titel (z.B. Bug-Report-System)" required />
            <label>Neue Features (eines pro Zeile)</label>
            <textarea id="clFeatures" rows="4" placeholder="- Neue Funktion 1&#10;- Neue Funktion 2"></textarea>
            <label>Bugfixes (eines pro Zeile)</label>
            <textarea id="clFixes" rows="3" placeholder="- Fix 1&#10;- Fix 2"></textarea>
            <label>Commit-Hashes (optional, Komma-getrennt)</label>
            <input type="text" id="clCommits" placeholder="abc123, def456" />
            <div class="cl-form-actions">
              <button type="button" class="secondary-btn" onclick="closeClModal()">Abbrechen</button>
              <button type="submit" class="primary-btn">Speichern</button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <script src="/js/app.js?v=<%= Date.now() %>"></script>
    <script src="/js/changelog.js?v=<%= Date.now() %>"></script>
  </body>
</html>
