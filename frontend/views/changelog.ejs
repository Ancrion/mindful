<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Mindful – Versionsverlauf</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.svg" />
    <link rel="stylesheet" href="/css/design-system.css?v=<%= Date.now() %>" />
    <link rel="stylesheet" href="/css/components.css?v=<%= Date.now() %>" />
    <link rel="stylesheet" href="/css/layout-components.css?v=<%= Date.now() %>" />
    <link rel="stylesheet" href="/css/animations.css?v=<%= Date.now() %>" />
    <link rel="stylesheet" href="/css/polish.css?v=<%= Date.now() %>" />
    <link rel="stylesheet" href="/css/accessibility.css?v=<%= Date.now() %>" />
    <link rel="stylesheet" href="/css/style.css?v=<%= Date.now() %>" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
  </head>
  <body>
    <div class="app-layout">
      <%- include('partials/sidebar') %>

      <main class="changelog-main">
        <header class="changelog-header">
          <h1>Versions<span>verlauf</span></h1>
          <p class="subtitle">Alle Änderungen und Neuerungen in Mindful.</p>
        </header>

        <div class="changelog-timeline" id="changelogTimeline">
          <% if (typeof clEntries !== 'undefined' && clEntries.length) { %>
            <% clEntries.forEach(function(e, i) { %>
            <div class="cl-entry <%= i === 0 ? 'latest' : '' %>">
              <div class="cl-entry-line">
                <div class="cl-dot"></div>
                <% if (i !== 0) { %><div class="cl-line"></div><% } %>
              </div>
              <div class="cl-entry-card">
                <div class="cl-entry-head">
                  <span class="cl-version-badge">v<%= e.version %></span>
                  <span class="cl-date"><%= new Date(e.datum + 'T00:00:00').toLocaleDateString('de-DE', { day: '2-digit', month: 'long', year: 'numeric' }) %></span>
                </div>
                <h3 class="cl-entry-title"><%= e.titel %></h3>
                <% if (e.features && e.features.length) { %>
                <ul class="cl-list">
                  <li class="cl-list-label cl-feature">Neu</li>
                  <% e.features.forEach(function(f) { %>
                    <li><%= f %></li>
                  <% }); %>
                </ul>
                <% } %>
                <% if (e.fixes && e.fixes.length) { %>
                <ul class="cl-list">
                  <li class="cl-list-label cl-fix">Behoben</li>
                  <% e.fixes.forEach(function(f) { %>
                    <li><%= f %></li>
                  <% }); %>
                </ul>
                <% } %>
                <% if (e.commits && e.commits.length) { %>
                <details class="cl-commits">
                  <summary class="cl-commits-summary">
                    <i class="fas fa-code-branch"></i> Commits (<%= e.commits.length %>)
                  </summary>
                  <div class="cl-commits-list">
                    <% e.commits.forEach(function(c) { %>
                      <a href="https://github.com/Ancrion/mindful/commit/<%= c %>" target="_blank" class="cl-commit-link" title="Commit auf GitHub anzeigen">
                        <code><%= c.substring(0, 7) %></code>
                        <i class="fas fa-external-link-alt"></i>
                      </a>
                    <% }); %>
                  </div>
                </details>
                <% } %>
                <div class="cl-entry-actions">
                  <a href="https://github.com/Ancrion/mindful/commits" target="_blank" class="btn btn-secondary btn-sm">
                    <i class="fas fa-code-branch"></i> Commits auf GitHub
                  </a>
                </div>
              </div>
            </div>
            <% }); %>
          <% } else { %>
            <p class="loading">Lade Versionsverlauf …</p>
          <% } %>
        </div>
      </main>

    </div>

    <script src="/js/app.js?v=<%= Date.now() %>"></script>
    <script src="/js/changelog.js?v=<%= Date.now() %>"></script>
  </body>
</html>
