<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Mindful – Versionsverlauf</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.svg" />
    <link rel="stylesheet" href="/css/design-system.css?v=<%= Date.now() %>" />
    <link rel="stylesheet" href="/css/components.css?v=<%= Date.now() %>" />
    <link rel="stylesheet" href="/css/layout-components.css?v=<%= Date.now() %>" />
    <link rel="stylesheet" href="/css/animations.css?v=<%= Date.now() %>" />
    <link rel="stylesheet" href="/css/polish.css?v=<%= Date.now() %>" />
    <link rel="stylesheet" href="/css/accessibility.css?v=<%= Date.now() %>" />
    <link rel="stylesheet" href="/css/style.css?v=<%= Date.now() %>" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <style>
      .changelog-body { max-width: 800px; margin: 40px auto; padding: 0 24px; line-height: 1.7; }
      .changelog-body h1 { font-size: 1.8rem; margin-bottom: 4px; }
      .changelog-body h1 span { color: var(--color-primary); }
      .changelog-body h2 { font-size: 1.3rem; margin: 32px 0 8px; padding-bottom: 4px; border-bottom: 1px solid var(--border-primary); }
      .changelog-body h3 { font-size: 1.1rem; margin: 24px 0 4px; }
      .changelog-body ul { padding-left: 20px; }
      .changelog-body li { margin-bottom: 4px; }
      .changelog-body a { color: var(--color-primary); }
      .changelog-body code { background: var(--bg-secondary); padding: 2px 6px; border-radius: 4px; font-size: 0.85em; }
      .changelog-body hr { margin: 32px 0; border: none; border-top: 1px solid var(--border-secondary); }
      body.dark .changelog-body code { background: var(--surface); }
    </style>
  </head>
  <body>
    <div class="app-layout">
      <%- include('partials/sidebar') %>

      <main class="changelog-main">
        <header class="changelog-header">
          <h1>Versions<span>verlauf</span></h1>
          <p class="subtitle">Alle Änderungen und Neuerungen in Mindful.</p>
        </header>

        <div class="changelog-body"><%- clHtml %></div>
      </main>
    </div>

    <script src="/js/app.js?v=<%= Date.now() %>"></script>
  </body>
</html>
